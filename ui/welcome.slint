import { Theme } from "theme.slint";
import { PrimaryButton, GhostButton } from "widgets.slint";

export struct SessionInfo {
    id: string,
    name: string,
    host: string,
    serial-detail: string, // device, baud rate and framing; empty for non-serial sessions (#422)
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    last-used: string, // ISO timestamp or "never"
    group: string,        // folder/group name ("" = ungrouped)
    group-header: string, // set on the first row of each group → render a header
    collapsed: bool,      // group is collapsed → this session row is hidden
    builtin: bool,        // built-in local shell, not a saved server session
    // (#session-status-dot-r2 2026-09-05) 连接状态(Rust 从 tabs 模型汇总回
    // 写):0 无点 / 1 未连接(黄,含连接中与已断开,与标签页黄点同语义)/
    // 2 已连接(绿)。成员行图标右上角点亮对应徽章。
    conn-state: int,
    // (#group-count-badge 2026-09-05) 组内成员数:仅组头行非 0(Rust 在
    // build_session_rows 时按过滤后的组成员数填),用于组头行尾的计数徽章。
    group-index: int,
    group-size: int,
    // (#first-group-no-pending 2026-09-10) 该行所属组是【列表最顶的可进入
    // 组】:拖拽状态机用它表达"本组之上没有可进入的组"。成员上移时跳过
    // "待出组(pending)"中间态,直接进"出组"(ghost = 蓝框 + 组别样式,本组
    // 组名蓝框不亮)。由 Rust 在 build_session_rows 计算,取 display_groups
    // 首项——(#default-group-drop 2026-09-10) 默认组存在时即默认组(其上方
    // 只有不可进入的 builtin 本地终端)。
    first-group: bool,
    // (#session-hover-card-r2 2026-09-05) 会话备注(可选):悬停信息卡片
    // 的"备注"行,有内容才显示。
    note: string,
    // (#session-drag-smooth 2026-09-05) 组内序(0..n,Rust 按过滤后顺序填):
    // 拖拽让位计算用——被拖行越过的同组成员向反方向平移一行高。
    // (#group-hue 2026-09-10) 组色相索引:Rust 按【组名 hash】算出(同一组
    // 恒同色、与排序/顺序无关),具体色值在 theme.slint 的 group-hue-color()
    // 里按明暗主题取——颜色定义留在主题层,主题切换自动生效。-1 = 无组
    // (group == ""),回落中性 border-subtle。
    group-hue: int,
}

// (#ctx-menu-autoclose 2026-09-09) 右键菜单"一步换目标"的行命中注册项:
// 菜单打开时每个可见行/组头把自身窗口矩形与身份注册上来(见 srow/gh-shell
// 的 changed ctx-open-key);backdrop 右击时按坐标命中,直接切换菜单,无需
// 二次右击。gen = 打开会话代数,命中时只匹配当前代(忽略历史残留)。
export struct CtxRowHit {
    x: length,
    y: length,
    w: length,
    h: length,
    space-below: length,   // 行底到面板底余量,菜单上翻判定用
    key: string,           // 菜单 key:session.id / "hdr:"+组名
    kind: string,          // "row" | "group"
    group: string,
    empty: bool,
    gen: int,
}

// --- SessionRow ------------------------------------------------------------
component SessionRow inherits Rectangle {
    in property <SessionInfo> session;
    in property <bool> compact;
    callback connect();
    callback edit();
    callback duplicate();
    callback move-to-group(string);
    callback remove();
    // Drag-to-reorder: direction -1 = up, 1 = down. Emitted once per row-hop.
    callback reorder(int) -> bool;
    // Drag lifecycle, owned by the Welcome list: start publishes the dragged
    // id, end persists the order. The card never follows the pointer — hops
    // swap rows instantly, so overlapping neighbours / group headers cannot
    // happen at all.
    callback drag-start();
    callback drag-end();
    // Full session list — group-header is non-empty once per group, so the
    // "move to group" submenu can iterate it to list each group exactly once.
    in property <[SessionInfo]> all-sessions;
    // Drag is only allowed outside search (visible indices would not match
    // stored order) and never on built-in system rows.
    in property <bool> reorder-enabled: false;
    // Shared list-level drag state (see Welcome): which session is being
    // dragged. The lifted card follows the dragged session's DATA, not the
    // component holding the pointer grab — rows swap contents under the grab
    // on every hop.
    // (#drag-ghost 2026-09-06) 原 drag-target(被拖行抬升态)随本体跟手
    // 一并废弃:拖动中本体隐形,抬升观感由 ghost 浮动卡承担。
    // List-level drag state, mirrored here so a press can detect a stale
    // drag (the grab was lost when a hop changed the row count and rebuilt
    // the model) and clear it instead of leaving the card lifted.
    in property <bool> list-dragging: false;
    // (#session-drag-smooth 2026-09-05 → #drag-ghost-pointer 2026-09-06) 拖
    // 动共享状态精简为三样:指针偏移 / 被拖 id / 真实行距(ghost 高度用)。
    // dn×pitch 槽位抽象整体退役:组头 46px 与组间 8px 使视觉行距不均匀,
    // 任何"累计偏移→槽位"换算都与所见脱节(多轮"不丝滑"的公共根因)。
    in property <length> drag-dy;
    in property <string> drag-id;
    // (#drag-pointer-geom 2026-09-07) 指针在列表内容坐标里的 y【未钳制】。
    // 旧实现传的是钳制后的 ghost 中心:列表一滚动,内容坐标就远大于可视
    // 高度,clamp 把落点死死钉在首尾两行——拖过头也不变(用户反馈"首尾
    // 粘住""长列表拖不到位"的公共根因)。判定必须与显示解耦:这里只收几何
    // 真值,ghost 卡自己钳制后再画,钳制结果不再参与任何落点计算。
    in property <length> pointer-y: 0px;
    // (#slot-shift-r2 2026-09-07) 让位:纯几何规则——本行在被拖行下方且指针
    // 越过本行中线 → 上移一行;在上方且指针退到中线之上 → 下移一行。
    // 组头行(含兼组头的成员首行,group-header != "")不让位:它一动画,
    // 组头会和成员分离。
    // (#drop-slot-box-r2 2026-09-07) 回退 r2 的"组头命中 → 该组成员整体
    // 让位"分支:组在洞上方时成员下移会与相邻组头重叠、方向分支又让
    // 组头下空档消失(文字叠文字的根源);组头命中现在只靠组头自身
    // 描边+淡底表达,成员不动,零重叠风险。
    // 位移输出到根元素 y + animate:animate 是 property-change 驱动的,绑定
    // 翻转产生的真实变化才会启动动画(不能用 if 包动画元素,那永不启动)。
    in property <length> drag-origin-y: 0px;
    // (#slot-shift-same-group) 被拖行所属组:仅同组行参与让位(跨组让位
    // 步长失配撞组头壳,叠印/穿组根源)。
    in property <string> drag-group: "";
    // (#shift-drop-same-source 2026-09-09) 欢迎页级两态标志(待出组/出组):
    // 两态期间本行不让位,避免空档暗示"插入"而松手却是出组(指示与提交不
    // 同源)。组件内拿不到 Welcome,经实例绑定传入。
    in property <bool> drop-over-pending: false;
    in property <bool> drop-over-out: false;
    // (#drag-fly-home 2026-09-10) 取消归位窗口期:让位冻结、行命中停报、
    // 本体行立即复现(ghost 正在飞回原槽)。
    in property <bool> drag-fly-home: false;
    // (#drag-fly-home-r2 2026-09-10) 归位落地复位:取消路径(Esc/右键/切窗)
    // 下 up 事件往往已丢失,grab-dragging 会残留,飞回窗口结束后本体行恒为
    // 洞(opacity 0)、光标恒为 move——用户观感"卡死"的直接来源。落地那一刻
    // (drag-fly-home 翻 false)若仍处拖起标记则强制复位,行恢复可见与可点。
    changed drag-fly-home => {
        if (!root.drag-fly-home && root.grab-dragging) {
            root.grab-dragging = false;
            root.pressing = false;
        }
    }
    // (#drag-stale-click) 切窗口残留拖拽后,下一次按下仅清状态不触发连接。
    in-out property <bool> drag-cancel-pending: false;
    // (#drop-slot-box-r3) 组首成员行(group-header != "")从完全不让位改为
    // 【禁上移、允下移】:上移会撞独立渲染的组头壳(壳不随成员位移),
    // 完全不让位又让"从下往上拖"时空档永远进不了组头正下方。下移无
    // 碰撞(同组内步长均匀):指针退到组首中线之上 → 组首下移一格,
    // 空档 = 组头下 = "插到组第一位"的让位视觉。
    // (#slot-shift-line-base-r2 2026-09-07) 让位基准 = 拖动成员(ghost 卡)
    // 的边界越过成员名称(行中线):拖动下移看【下边界】(ghost 底 = 指针
    // + pitch-2),拖动上移看【上边界】(ghost 顶 = 指针)。几何换算后两个
    // 分支对称于行中线 ± half:
    //   下移: ghost 底 > X 中线  ⇔  pointer > slot-y - half → X 上移让位
    //   上移: ghost 顶 < X 中线  ⇔  pointer < slot-y + half → X 下移让位
    // 横线已退役,让位动画本身就是落点指示。
    property <length> line-half: (root.drag-pitch - 2px) / 2;
    // (#cross-group-shift 2026-09-07) 放开两个旧限制:
    // ① 跨组不让位(session.group != drag-group):移入其它组时目标成员要
    //    动态让位,否则跨组拖动全程没有空档,看不出会插到哪里;
    // ② 组头行(兼首行)不让位:组头卡 gh-card 已同步 gh-shift-y,整块一起
    //    让位不再分离(旧限制的成因),见 gh-shell #cross-group-shift。
    // (#pending-group-yield 2026-09-10) 用户定稿"抽屉"式出组:待出组+出组
    // 期间,本组(drag-group 相同)成员行按几何下移让位且【保持】——出组
    // 不恢复原位(用户定稿:组头下移就好,无"先下移再上移"),洞被上方
    // 成员链下移吸收(本体原槽不再留在组中);回进入组(member-mode)才
    // 恢复常规让位。异组行在两态期间维持抑制,避免邻组误导性空档。
    // (#drag-fly-home) 取消归位窗口期让位冻结归零。
    out property <length> shift-y:
        !root.list-dragging || session.builtin || session.id == root.drag-id
        || root.drag-fly-home
        || ((root.drop-over-pending || root.drop-over-out)
            && session.group != root.drag-group) ? 0px
        : slot-y > root.drag-origin-y
            && root.pointer-y > slot-y - self.line-half ? -(root.drag-pitch)
        : slot-y < root.drag-origin-y
            && root.pointer-y < slot-y + self.line-half ? root.drag-pitch
        : 0px;
    in-out property <length> drag-pitch: 40px;
    // (#drag-ghost-pointer 2026-09-06) 指针几何落点:slot-y = 本行在列表内容
    // 坐标里的 y(实例侧拖拽中经 changed 钩子写入,非 init 绑定),配合
    // root.ghost-y 判定 ghost 悬停在本行哪
    // 一半;命中行经 drop-report 上报 (target, after, 槽位y),Welcome 级
    // 画主题色槽位框(#drop-slot-box),松手按快照一次提交。
    // (#drag-ghost-pointer 2026-09-06) 私有存储 + 实例侧可写:升为 in-out 是
    // 为了让实例的 changed 钩子能写入(实例块里不能给私有 property 赋值)。
    // 关键点:本属性【没有 init 绑定】,启动期恒为 0px;只在拖拽中经实例的
    // changed list-dragging 钩子写入(见下方实例区),从而避免 init 期读自身
    // 几何触发 Recursion detected 的 panic。
    in-out property <length> slot-y: 0px;
    // (#drop-ghost-edge 2026-09-07) 落点判定基准 = ghost 卡按拖动方向的
    // 【前导边】:下移用下边界(pointer + 行高),上移用上边界(pointer)。
    // 旧实现恒用指针点:上移方向 ghost 顶恰等于指针点,让位与提交天然
    // 同步;下移方向让位基准是 ghost 底,比指针点深一个行高——视觉已
    // 让位、快照仍停在 (被拖行自身) 或 (目标行, before),松手全部提交
    // 成原地不动,要多拖一行才前进一位(#slot-shift-line-base-r2 的
    // 不对称副作用的提交侧修正)。方向对齐后:下移"ghost 底越过成员
    // 名字(让位发生)" ⇔ drop-after 翻 true,松手即落空档;上移对称。
    // (#drop-y-directional 2026-09-08) 命中基准保持方向性(用户定稿):上移
    // 按【顶边】、下移按【底边】。中心基准方案废弃——它会让间隙处直接
    // 入组,跳过用户定义的待出组过渡。
    property <length> drop-y:
        root.pointer-y > root.drag-origin-y
            ? root.pointer-y + (root.drag-pitch - 2px)
            : root.pointer-y;
    // (#drag-pointer-geom) 顶部越界交给哨兵处理(见 list-host.over-head),
    // 不由 clamp 兜底。(底部越界 = 移出分组,见 over-ungroup。)
    // (#group-head-directional 2026-09-08) 组头行不参与行落点:压组头的
    // 语义 = 进该组第一位(gh-overlap,组头外壳判定),行落点若仍命中
    // 组头行会当帧清掉组头蓝框并按残留落点误提交。进组一律走成员行
    // 落点;组头行的点击/折叠/右键不受影响(仅拖拽落点)。
    property <bool> ghost-over:
        root.list-dragging && root.drag-id != "" && session.id != root.drag-id
        && !session.builtin
        && !root.drag-fly-home
        && self.drop-y >= slot-y
        && self.drop-y < slot-y + self.height;
    // (#drag-pointer-geom) 越过本行中线即"插到之后";基准与 ghost-over
    // 同为 drop-y,保证命中行与半区出自同一几何。
    property <bool> drop-after: self.drop-y > slot-y + self.height / 2;
    // (#bottom-ingress 2026-09-08) 底缘入组接管:上移跨组时 ghost 顶悬在
    // 组名下方间隙(顶基准无行命中),底缘已压住目标组最后成员——此时
    // 顶基准失效会误回落"组间空隙 = 出组态"(蓝框误亮)。异组成员行被
    // ghost 底缘压住即上报入组候选;是否采纳由 Welcome 的 16ms 仲裁
    // Timer 决定(顶基准命中优先,本 tick 无顶命中才采纳候选)。
    property <bool> ghost-bottom-over:
        root.list-dragging && root.drag-id != "" && session.id != root.drag-id
        && !session.builtin && session.group != root.drag-group
        && !root.drag-fly-home
        && root.pointer-y < root.drag-origin-y
        && self.drop-y + (root.drag-pitch - 2px) >= slot-y
        && self.drop-y + (root.drag-pitch - 2px) < slot-y + self.height;
    callback bottom-report(string /* candidate-id */, string /* group */, int /* position */);
    changed ghost-bottom-over => {
        if (self.ghost-bottom-over) {
            // (#ghost-pill) 底缘候选的语义 = 加入该组**末尾**,位次 = 组大小 + 1。
            root.bottom-report(session.id, session.group, session.group-size + 1);
        }
    }
    // (#ghost-band 2026-09-07) 第三参 = 落点行的 group:Welcome 根据此决定
    // ghost 卡的层级样式(顶层 / 组内成员)。组件内拿不到 Welcome 的
    // property(此作用域的 root 是本行),一律经回调上报。
    // (#ghost-pill 2026-09-10) 追加第 4 参:落点在目标组内的位次(1 基)。
    // ghost 右侧的落点标签(`→ 组名 · 第 N 位`)用它;由行按自己的
    // group-index + 半区算出,Welcome 侧只做展示。
    callback drop-report(string /* target-id */, bool /* after */, string /* group */,
        int /* position */);
    callback drop-leave(string /* leaver-id */);
    // 命中即上报(后写覆盖;ghost 中心同一时刻只可能落在一行内)。
    // 移出(true→false)不上报:残留目标 = 最后经过的行,拖到组头/空白
    // 区松手时落到邻近行,符合直觉。
    changed ghost-over => {
        if (self.ghost-over) {
            root.drop-report(session.id, self.drop-after, session.group,
                // (#ghost-pill) 位次(1 基) = 组内 0 基序号 + 半区偏移 + 1。
                session.group-index + (self.drop-after ? 1 : 0) + 1);
        } else {
            root.drop-leave(session.id);
        }
    }
    // (#drop-after-live 2026-09-07) 半区翻转必须补报:changed ghost-over
    // 只在指针进入本行那一刻采样一次 after,指针继续下移越过中线后
    // ghost-over 保持 true、changed 不再触发,root 落点快照停留在进入
    // 瞬间的 false——松手提交与视觉差半行。在此对每次中线翻转(无论
    // 方向)实时重报,快照与指示恒一致。
    changed drop-after => {
        if (self.ghost-over && root.list-dragging) {
            root.drop-report(session.id, self.drop-after, session.group,
                // (#ghost-pill) 位次(1 基) = 组内 0 基序号 + 半区偏移 + 1。
                session.group-index + (self.drop-after ? 1 : 0) + 1);
        }
    }
    property <bool> system-row: root.session.builtin;
    // (#session-tree-hierarchy 2026-09-04) 树形层级:成员行相对分组头缩进
    // content-indent,并可选显示树形引导竖线——每行画一段(border-subtle,
    // 位于缩进区中点),行间距 2px 时视觉上连成一条,文件树的标准画法。
    in property <length> content-indent: 0px;
    in property <bool> tree-guide: false;
    // (#tree-line-hover 2026-09-10) 组脊线 hover 联动。脊线是按行分段画
    // 的(架构里没有"组容器"),要让**整条**组脊线一起亮,必须把"鼠标当前
    // 悬停所属组"提升到 Welcome 级共享状态,组内所有成员行据此同时渲染
    // 高亮态——否则只会亮鼠标底下那一小节,像扫描而不像"这条线属于这组"。
    // hover-key = "谁写的"标记(组头写作 "hdr:组名",成员写作 行id),用于
    // 跨行/跨组交接时防止旧行把新行刚写入的状态误清空:只有 key 仍指向
    // 自己才允许清空。实测交握逻辑保证同组内换行零空帧(不闪)。
    in-out property <string> hover-group: "";
    in-out property <string> hover-key: "";
    // Local gesture state: this instance received the press and drives the
    // drag (it keeps the pointer grab across in-place model updates).
    property <bool> pressing: false;
    property <bool> grab-dragging: false;
    property <length> grab-y;
    property <length> grab-x;

    height: root.compact ? 38px : 36px;
    // (#slot-shift) 让位位移:配合外包 wrapper 使用(布局子元素不能设 y)。
    y: root.shift-y;
    // (#ease-align-spec 2026-09-10) 140ms + cubic-bezier(.22,.61,.36,1):
    // 对齐交互原型/规格 §5·§6 的让位动画参数(原 120ms ease-out)。缓动曲线
    // 换成 spec 那条"前段快、后段收"的曲线,多行连续让位时更跟手。
    animate y { duration: 140ms; easing: cubic-bezier(0.22, 0.61, 0.36, 1); }

    // Remember where the right-click landed so the popup can appear there.
    // (#ctx-menu-backdrop 2026-09-08) 右键菜单整体迁往 AppWindow 根的集中
    // 浮层(全窗口透明 backdrop + 菜单本体):关闭事件 100% 确定(点背景即
    // 关+清 key),替代 PopupWindow 无 closed 回调时代的轮询猜测。行内只
    // 负责把点击点(行内坐标)经 ctx-opening 上报。
    // (#ctx-menu-pin-r2) 菜单打开高亮改全局单值 key(Welcome 级),本行
    // 被右击时保持 hover 高亮;键被顶掉/背景点击清空即熄灭。
    in property <string> ctx-open-key: "";
    // (#ctx-line-keep 2026-09-10) 当前右键菜单的锚点是否落在**本组**内。
    // 菜单一弹出鼠标就离开行,hover 全线失效:若竖线只认 hover,就会出现
    // "底色/横线还亮着、整组竖线先黑掉"的割裂(用户截图:右击成员或组头后
    // 竖线高亮被取消)。由实例处一次性算好,避免把 ctx-menu-group 这类菜单
    // 内部字段泄进行组件。
    in property <bool> ctx-group-active: false;
    callback ctx-opening(length, length /* mouse-x, mouse-y */);

    touch := TouchArea {
        // (#cursor-no-hand 2026-09-10) hover 光标 pointer → default:会话行
        // 是**命令项**(点了直接开终端),不是导航链接;Windows 原生列表
        // (资源管理器/任务管理器)在这一类行上给的都是标准箭头,手型会
        // 误传"这是个超链接"的语义(用户截图反馈)。拖拽中的 move 保留,
        // 它是"正在搬运"的唯一视觉信号。
        mouse-cursor: root.grab-dragging ? move : default;
        // (#session-hover-card) 悬停离开时清掉信息卡片(写入在 info-delay)。
        changed has-hover => {
            if (!self.has-hover && root.card-out-name != "") {
                root.card-out-name = "";
            }
            // (#tree-line-hover) 上报/撤销"鼠标悬停所属组"。
            if (self.has-hover) {
                root.hover-key = root.session.id + "|" + root.session.group;
                root.hover-group = root.session.group;
            } else if (root.hover-key == root.session.id + "|" + root.session.group) {
                root.hover-key = "";
                root.hover-group = "";
            }
        }
        // Connect is handled in pointer-event below so a finished drag never
        // counts as a click.
        pointer-event(e) => {
            // Built-in PowerShell/CMD/WSL rows have no edit/move/delete actions.
            // All menu items are conditional on !system-row, so opening the
            // popup for them only produces an empty rectangle (#336).
            if (!root.system-row && !root.list-dragging
                && e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                // (#ctx-menu-backdrop) 上报点击点,菜单由 AppWindow 根浮层渲染。
                root.ctx-opening(self.mouse-x, self.mouse-y);
            } else if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    // A press while the list still thinks a drag is running
                    // means that drag's pointer grab was destroyed by a
                    // row-count-changing hop; end it before starting fresh.
                    // (#drag-stale-click) 切窗口回来的残留拖拽也走这里:
                    // 标记本次按下只用于清残留,松开不得触发连接。
                    if (root.list-dragging) {
                        // (#drag-fly-home-r2 2026-09-10) 归位窗口期内按下不打断
                        // 飞回动画:此刻 drag-end 会清掉 drag-id 让 ghost 提前
                        // 消失(而非飞回)。仅标记本次按下只用于清残留。
                        if (!root.drag-fly-home) {
                            root.drag-end();
                        }
                        root.drag-cancel-pending = true;
                    }
                    root.pressing = true;
                    // Reset any stale drag (e.g. released outside the row).
                    root.grab-dragging = false;
                    root.grab-y = self.mouse-y;
                    root.grab-x = self.mouse-x;
                } else if (e.kind == PointerEventKind.up) {
                    // `pressing` proves this instance received the down: the
                    // row under a released pointer must not treat it as a
                    // click when the grab landed elsewhere after hops.
                    if (root.pressing && !root.grab-dragging) {
                        if (root.drag-cancel-pending) {
                            root.drag-cancel-pending = false;
                        } else {
                            root.connect();
                        }
                    }
                    // (#drag-fly-home-r2 2026-09-10) 归位窗口期内不提交:取消
                    // (Esc/右键/切窗)已在处理,此处 drag-end 会清掉 drag-id 让
                    // ghost 提前消失(而非飞回)。剩余态交由落地 Timer 收尾。
                    if (root.grab-dragging && !root.drag-fly-home) {
                        root.drag-end();
                    }
                    root.pressing = false;
                    root.grab-dragging = false;
                } else if (e.kind == PointerEventKind.cancel) {
                    // System-cancelled grab (e.g. compositor takeover): treat
                    // as a release but never as a connect click.
                    // (#drag-fly-home-r2) 归位窗口期同样不提交。
                    if (root.grab-dragging && !root.drag-fly-home) {
                        root.drag-end();
                    }
                    root.pressing = false;
                    root.grab-dragging = false;
                }
            }
        }
        moved => {
            if (!root.pressing) { return; }
            if (!root.grab-dragging) {
                // (#drag-axis-lock 2026-09-07) 方向锁:只有纵向位移占主导才
                // 判定为拖拽意图。触控板点选常伴随几像素斜向漂移,旧逻辑只
                // 看 |dy| > 5px,斜着划一下就变成拖拽、松手又落回连接,是
                // "误触连错机器"的直接来源。现在要求 |dy| > 7px 且
                // |dy| ≥ |dx|;横向为主的手势一律不进入拖拽。
                if (root.reorder-enabled
                        && abs(touch.mouse-y - root.grab-y) > 7px
                        && abs(touch.mouse-y - root.grab-y) >= abs(touch.mouse-x - root.grab-x)) {
                    root.grab-dragging = true;
                    root.grab-y = touch.mouse-y;
                    // (#drag-smooth-fix) 上报真实行距,供 dn 阈值 / 让位 / 落位共用。
                    root.drag-pitch = root.height + 2px;
                    // (#hover-card-drag 2026-09-07) 悬停卡先弹、后拖起时 running
                    // 变 false 只停计时器,已写出的 card-out-* 无人清(has-hover
                    // 在拖拽 grab 下恒 true),信息浮窗全程跟随拖拽——进入拖拽
                    // 此刻显式清掉。
                    root.card-out-name = "";
                    root.drag-start();
                }
            }
            // (#session-drag-smooth 2026-09-05) 拖动过程不 mutate 模型:只持
            // 续上报指针偏移;(#drag-ghost-pointer 2026-09-06) 跟手元素是列
            // 表级 ghost 浮动卡(本体隐形留洞),落点由各行按指针几何自判
            // (插入指示线),松手按 (命中行, 前/后) 一次提交。
            root.drag-out-dy = touch.mouse-y - root.grab-y;
        }
    }

    // (#session-hover-card 2026-09-05) 悬停 0.45s 后把主机信息写给 Welcome
    // 的 card-out-*(经 Welcome 中转到 AppWindow 根的集中浮层,同 topbar-tip
    // 机制,不受行裁剪/模态影响);移开即清。行内副标题在悬停期间隐藏
    // (见 info-sub 的 visible 绑定)。
    // (#session-hover-card-r2) 改为结构化三字段(名称/主机/备注),浮层按
    // "标签: 值"逐行渲染,备注可选。
    in-out property <string> card-out-name;
    in-out property <string> card-out-host;
    in-out property <string> card-out-note;
    in-out property <length> card-out-x;
    in-out property <length> card-out-y;
    in-out property <length> drag-out-dy;   // (#session-drag-smooth) 拖动中的指针偏移输出
    info-delay := Timer {
        interval: 450ms;
        running: touch.has-hover && !root.list-dragging;   // 拖动中不弹信息卡
        triggered => {
            // (#hover-card-drag) running 翻转与 triggered 的竞态防护:
            // 拖拽已拉起时不再写出信息卡。
            if (!root.list-dragging) {
                root.card-out-name = root.session.name;
                root.card-out-host = root.session.builtin
                    ? root.session.host
                    : (root.session.user != "" ? root.session.user + "@" : "")
                        + (root.session.port > 0
                            ? root.session.host + ":" + root.session.port
                            : root.session.host);
                root.card-out-note = root.session.note;
                root.card-out-x = touch.absolute-position.x + touch.width + 6px;
                root.card-out-y = touch.absolute-position.y;
            }
        }
    }

    // Row content — wrapped in a card so it can hide in place while dragged
    // (洞) and tint when hovered by the ghost.
    // (#drag-ghost 2026-09-06) tabs #408 同款 ghost 模型:拖动期间卡片本体
    // 在原槽隐形(opacity 0 = 洞),跟手改由列表级 ghost 浮动卡承担(见
    // Welcome 列表末尾,声明序恒在最上层)。旧实现本体跟手,滞后带死区内
    // 邻行不动,卡片以 ~60% 重叠悬停压住邻行(用户截图);本体不再跟手后
    // 此类重叠在几何上不可能出现。
    // (#drag-ghost-pointer 2026-09-06 → #drop-slot-line-r5 2026-09-07)
    // 落点表达的历史沿革:曾用"命中行的插入指示线"(09-06),因行顶/行底
    // 两条线与让位几何在组头/组间距处脱节而整体退役(用户定稿"不要蓝色
    // 主题色线条")。现在 = 让位动画(shift-y) + 落点空槽框(见下方 slot-box)。

    // (#slot-box 2026-09-10) 落点空槽框:本行是 ghost 命中行时,在它的
    // after / before 侧画一圈描边,把"松手会插入的那个空档"标出来
    // (对齐交互原型的空槽)。位置取 ±drag-pitch(整行步长):命中行被让位
    // 挪开(或本体隐形成"洞")之后,那一步的位置正好是空档,取整步长与让位
    // 幅度同源,不会错位。声明在 card 之前 → 不盖住行内容。
    // 为什么不做虚线:Slint 的 Rectangle 没有 dashed 描边(border-style),
    // 拼块模拟要几十个矩形、每帧重排;淡底 + 1px 描边视觉等价,且在 femtovg
    // 下更稳(贴边 1px 线的重绘教训,见 spec §8)。
    if root.ghost-over : Rectangle {
        y: root.drop-after ? root.drag-pitch : -root.drag-pitch;
        x: 24px;
        width: root.width - 32px;
        height: root.drag-pitch - 2px;
        border-radius: Theme.radius-md;
        background: Theme.accent-solid.with-alpha(0.09);
        border-width: 1px;
        border-color: Theme.accent-solid.with-alpha(0.55);
    }

    card := Rectangle {
        // (#session-list-inset-revert 2026-09-05) 撤销 4px 内缩,恢复全宽:
        // 内缩后与右侧资源面板的行高亮宽度不一致,左右不协调(用户反馈)。
        // (#drag-ghost-pointer 2026-09-06) 卡片没有任何 y 位移。
        // (#drop-slot-line-r3 2026-09-07) 本体回归全隐形:35% 残影在暗主题
        // 下呈现为一个"空框虚拟块"(用户截图),观感差;半透明效果改由
        // 跟手的 ghost 卡承担(见 ghost 元素 with-alpha 0.62)。ghost-over
        // 的 accent 淡底删除——横线已是唯一落点指示。ghost-over 判定
        // 保留(上报用)。
        // (#ctx-menu-pin-r2) 右键菜单打开期间保持 hover 高亮(全局 key)。
        // (#drag-fly-home) 归位窗口期本体立即复现:ghost 飞回原槽落地时
        // 与行"合体",而非等用户松开左键才现身。
        opacity: root.grab-dragging && !root.drag-fly-home ? 0 : 1.0;
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-sm;
        // (#ctx-highlight-scope 2026-09-10) 高亮只认两件事:鼠标在本行,或
        // 本行是当前右键菜单的锚点。**不再有"目标常驻"**——常驻会让底色在
        // 鼠标移到别的行之后还赖着不走(用户截图:"移动其它区域这个背景也
        // 不消失了,体验很不好")。菜单一旦失效(离开安全区自动关闭 / Esc /
        // 选中一项),高亮立刻归位:列表的任何高亮都能被"鼠标在哪 + 菜单开
        // 没开"完整解释,没有第三个隐藏状态。
        background: (touch.has-hover || root.ctx-open-key == session.id)
            && !root.list-dragging ? Theme.bg-hover : transparent;
        animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px + root.content-indent;
        padding-right: 10px;
        spacing: root.compact ? 8px : 12px;

        Rectangle {
            // (#default-group-header 2026-09-10) 成员图标尺寸统一 16px:原先
            // default(未分组)成员走 20px + fs-xl 的"组头级"特例,那是"未分组
            // 平铺在顶层"时代的伪装;现在 default 有真正的组头,成员就该是
            // 标准成员尺寸,不再有第二套视觉。
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.bg-elevated;
            Text {
                text: root.system-row ? "\u{E30A}" : "\u{E875}";   // terminal / server
                font-family: "Material Icons";
                color: Theme.text-secondary;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // (#session-status-dot-r4 2026-09-05) 徽章位置:贴在图标方块左侧
            // 垂直中心(右缘与图标左缘搭接 2px),像信号灯挂在侧边,不再压角
            // 溢出,与左侧树引导线也保持距离(树线 x≈19,点 24..30)。
            if root.session.conn-state == 1 : Rectangle {
                x: -4px;
                y: (parent.height - self.height) / 2;
                width: 6px; height: 6px;
                border-radius: 3px;
                background: Theme.warning;
            }
            if root.session.conn-state == 2 : Rectangle {
                x: -4px;
                y: (parent.height - self.height) / 2;
                width: 6px; height: 6px;
                border-radius: 3px;
                background: Theme.success;
            }
        }

        // (#session-hover-card-r2 2026-09-05) 成员行单行化:只显示名称,
        // 与图标垂直居中对齐(主机/用户/备注等详情移至悬停信息卡片)。
        // 原双行(名称+副标题)布局废弃,行高与组头一致更整齐。
        if root.compact : Text {
            horizontal-stretch: 1;
            text: session.name;
            color: Theme.text-primary;
            // (#fs-align-design 2026-09-10) 侧栏(compact)成员名 fs-sm(12px)
            // → fs-md(13px),与组名**完全同号**。此前成员比组名小 1px,用户
            // 截图对比 HTML 设计稿反馈"组名和成员不一样大"——设计稿里两者
            // 都是 13px(仅字重 600/400 区分),这里补齐。
            font-size: Theme.fs-md;
            // (#default-group-header) 字重统一 400:成员就是成员,不再有
            // "默认组成员伪装成组头"的 700 字重分支。
            font-weight: 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.compact : Text {
            text: session.name;
            color: Theme.text-primary;
            // (#fs-align-design 2026-09-10) 宽列表同样收口到 fs-md:top-level
            // (默认组)成员原为 fs-lg(15px) 比组名大一档,与设计稿不符。
            font-size: Theme.fs-md;
            // (#default-group-header) 字重统一 400:成员就是成员,不再有
            // "默认组成员伪装成组头"的 700 字重分支。
            font-weight: 400;
            vertical-alignment: center;
            width: 180px;
            overflow: elide;
        }
        if !root.compact : Text {
            text: session.port > 0 ? session.host + ":" + session.port : session.host;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            width: 180px;
            overflow: elide;
        }
        if !root.compact : Text {
            text: session.user;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    }

    // (#tree-guide-keep-on-drag 2026-09-09) 树形引导竖线提到 card 之外:
    // 拖动期间 card.opacity 归零(原槽成洞),树线若留在 card 内会一并消失,
    // 原槽留下一段断线(用户截图反馈"左侧竖线要补全")。移为 SessionRow
    // 根同级元素后它不受 card.opacity 影响,始终锚在原槽位置补全竖线;非
    // 拖动态视觉不变(竖线位于左侧内缩区,不与内容重叠)。
    if root.tree-guide : Rectangle {
        // (#group-hue-align-html 2026-09-10) 2px + α0.30:对齐 HTML 原型
        // 规格(2px 组色 α0.28);2px 同时更抗 femtovg 邻接重绘闪烁。
        // (#tree-line-full-r2 2026-09-10) 竖线恢复**全行高**。上一版按
        // `group-header != ""` 砍成下半段是错的:纯组头行(id == "")根本不
        // 渲染 SessionRow,本就没有竖线;该判断实际只命中"组内第一个成员"
        // (id != "" 且 group-header != "",如 188 行),把它砍半 → 脊线在组头
        // 下方断了一截。恢复全高后,脊线自然从组头卡**下方**开始(组头卡片
        // 不含 tree-guide),既"不穿组头"又"不断线"。
        // (#tree-line-hover 2026-09-10) 悬停该组(组头或组内任一行)→ 整条
        // 脊线高亮。`hover-group != ""` 是必需的保护——空字符串是共享状态
        // 的初值,若不排除,所有 group == "" 的行会被判定为常亮(幽灵高亮)。
        // (#line-highlight-color-only 2026-09-10) **只提亮,不加粗**:上版
        // 高亮时宽 2px→3px 且 x 左移 0.5px 保轴心,虽然轴心不动,但半像素
        // 落在像素边界上会让线出现"半透边缘 + 相邻元素 1px 重绘"的抖动
        // 观感(用户反馈"加粗会影响布局")。改为宽度/位置恒定、只抬不透明
        // 度 0.30 → 0.90:结构线的高亮本质是"亮度层级"变化,用透明度表达
        // 最干净,也彻底避开几何改动。
        // (#ctx-highlight-scope 2026-09-10) 竖线的点亮范围 = "鼠标所在的组"
        // ∪ "右键菜单锚点所在的组"。两者都是**指向本组的指针**,语义一致:
        // 菜单开着时锚点就是这一组,竖线不该被取消(用户截图两例:右击成员、
        // 右击组头,都要求整组竖线保持高亮)。菜单一失效(自动关闭/Esc/选中
        // 一项),ctx-group-active 立刻回落 false,竖线随之熄灭——高亮仍能被
        // "鼠标在哪 + 菜单开没开"完整解释,没有第三个隐藏状态。
        property <bool> hot: root.ctx-group-active
            || (root.hover-group != "" && root.hover-group == root.session.group);
        x: 10px + (root.content-indent / 2) - 1px;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: Theme.group-hue-color(root.session.group-hue).with-alpha(self.hot ? 0.90 : 0.30);
        animate background { duration: 120ms; easing: ease-out; }
    }

    // (#tree-branch 2026-09-10) 成员横线:竖线 → 成员图标的 ├ 拐角。
    // 原型里脊线靠一条 9px 横杠接到成员圆点,成员才真正"长在"组上;没有
    // 横杠时竖线与成员只是"并排",从属关系靠脑补。x = 脊线右缘(20px),
    // 宽 8px 至图标方块左缘(28px);conn-state 圆点(x 24..30)绘制在上层,
    // 视觉正好呈现"竖线 — 横线 — 圆点"。竖线/横线同色同透明度,共成一根
    // 连续枝干。
    if root.tree-guide : Rectangle {
        // (#tree-line-hover 2026-09-10) 悬停该成员行 → 它自己的横线提亮。
        // 横线只属于这一行,所以条件用本行 hover 而非组级状态。
        // (#line-highlight-color-only 2026-09-10) **只提亮、不加粗**:与竖线
        // 同一原则(几何恒定优于动几何)。同时保证**竖线恒比横线粗**——
        // 竖 2px / 横恒 1px,高亮态也不改变这个权重关系,"主干 > 分支"的
        // 层级在任何状态下都成立(上版高亮时横线 1px→2px 会瞬间追平竖线,
        // 枝干层级在高亮瞬间被抹掉)。长度同样锁定 8px:再长会伸进图标
        // 方块(图标起于 28px,横线止于 28px 正好搭边)。
        // (#ctx-highlight-scope) 横线是**这一行自己的**枝干,点亮范围严格
        // 等于这一行:悬停本行,或本行是当前菜单锚点(菜单开着时鼠标可能已
        // 移到菜单上,横线不该跟着黑掉)。与底色同源、同范围。
        property <bool> hot: touch.has-hover || root.ctx-open-key == root.session.id;
        x: 10px + (root.content-indent / 2) + 1px;
        y: (parent.height - 1px) / 2;
        width: 8px;
        height: 1px;
        background: Theme.group-hue-color(root.session.group-hue).with-alpha(self.hot ? 0.90 : 0.30);
        animate background { duration: 120ms; easing: ease-out; }
    }

    // (#single-drop-slot 2026-09-07) 插入指示线整体退役:行顶/行底两条线是
    // "两成员间两个位置"错觉的视觉根源(即使语义等价,用户也会把蓝线在 A 底
    // 与 B 顶解读为两个不同落点)。现在让位动画(邻行移开腾出的空档)是唯一
    // 落点指示——空档在哪,松手就插在哪,一个间隙一个位置,零歧义。落点判定
    // (drop-after 行中线)与让位阈值(slot-y + 行高/2)天然同步,空档位置 =
    // 提交位置。
}

component CollapseButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.glyph;
        font-family: "Material Icons";
        color: Theme.text-secondary;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// --- Welcome ---------------------------------------------------------------
export component Welcome inherits Rectangle {
    in property <[SessionInfo]> sessions;
    in property <string> import-hint;        // result text after an import
    in-out property <string> search-query;
    // (#session-hover-card) 成员行 hover 信息卡片的中转槽:SessionRow 写入,
    // 实例侧绑定到 AppWindow 根的集中浮层(链路 SessionRow→Welcome→根)。
    in-out property <string> card-out-name;
    in-out property <string> card-out-host;
    in-out property <string> card-out-note;
    in-out property <length> card-out-x;
    in-out property <length> card-out-y;
    in-out property <length> drag-out-dy;   // (#session-drag-smooth) 拖动中的指针偏移输出
    // (#tree-line-hover 2026-09-10) 组脊线 hover 联动的 Welcome 级状态:
    // 行/组头写入"当前悬停所属组",组内每一行读它决定脊线是否高亮加粗。
    // 成员行(SessionRow)与内联的组头行共用这一对;hover-key 记"谁写的",
    // 防止旧行离场时把新行刚写入的状态误清空。
    in-out property <string> hover-group: "";
    in-out property <string> hover-key: "";
    in-out property <length> drag-dy: 0px;
    in-out property <length> drag-pitch: 40px;
    // (#drag-ghost-pointer 2026-09-06) 聚合落点:命中行经 drop-report 上报
    // (ghost 中心同一时刻只可能落在一行内,后写覆盖即正确值);
    // drag-start 清空,松手消费。ghost-y 的计算放在条件子树内(list-host,
    // 见列表区),那里才可见 sess-list;此处只留跨作用域共享的状态。
    property <string> drop-target-id: "";
    property <bool> drop-after: false;
    // (#ghost-pill 2026-09-10) 落点快照的另两件:目标行所属组 + 位次(1 基)。
    // 与 drop-target-id 同生命期(命中即写、松手/取消清)。旧字段 drag-drop-
    // group 在 drop-leave 时会回落到"拖起时的组",不能拿来当落点组用。
    property <string> drop-target-group: "";
    property <int> drop-target-pos: 1;
    // (#ghost-pill / #badge-preview 2026-09-10) 落点归属组:"" = 无落点。
    //  ① 组头命中(进组第一位) → 该组,位次 1;
    //  ② 行命中 → 落点行的组,位次取自行上报;
    //  ③ 回原位(待出组)/移出分组/取消归位 → 空,不给任何"将落在这里"的暗示。
    // ghost 右侧的落点标签与组头徽章预览(3 → 4)共用这一个判定。
    property <string> drop-here-group:
        root.drop-over-pending || root.drop-over-out || root.drop-over-ungroup
        || root.drag-fly-home ? ""
        : root.drop-over-group != "" ? root.drop-over-group
        : (root.drop-target-id != "" ? root.drop-target-group : "");
    property <int> drop-here-pos:
        root.drop-over-group != "" ? 1 : root.drop-target-pos;
    // (#ghost-pill 2026-09-10) 落点标签的组名:默认组的存储名是 "default",
    // 展示层要翻成「默认组」,与组头标题同一口径。
    property <string> drop-here-label:
        root.drop-here-group == "default" ? @tr("Default group") : root.drop-here-group;
    // (#group-drag-reorder 2026-09-06) 组头拖动排序:跟手浮起,松手按方向
    // 相邻换位(阈值 ±20px,一次一位;Rust 维护 explicit groups 顺序)。
    property <bool> group-dragging: false;
    property <string> group-drag-id: "";
    property <length> group-dy: 0px;
    callback reorder-group(string /* group */, int /* dir */);
    callback new-session();
    callback move-session-to(string /* session-id */, string /* target-id */, bool /* after */);   // (#drag-ghost-pointer) 几何落位转发 AppWindow
    callback import-ssh-config();
    callback connect-session(string);
    callback edit-session(string);
    callback duplicate-session(string);
    callback move-session(string /* id */, string /* group */);
    // Drag-to-reorder a host card among its same-group siblings (dir: -1/1).
    // Returns true when the card actually moved.
    callback reorder-session(string /* id */, int /* dir */) -> bool;
    // Drag finished (pointer released) → persist the new order.
    callback reorder-end();
    // Bumped by Rust whenever the sessions model is rebuilt wholesale; that
    // destroys the dragging row's pointer grab, so end the drag cleanly
    // instead of leaving the lifted card stuck (its grab is already gone —
    // no release event will ever arrive).
    in property <int> sessions-revision: 0;
    changed sessions-revision => {
        if (root.list-dragging) {
            root.list-dragging = false;
            root.drag-id = "";
            root.reorder-end();
        }
    }
    // List-level drag-to-reorder state: which session is being dragged.
    // Kept at list level because hops swap row data under the pointer grab —
    // the lifted card must follow the dragged session's data, not the
    // component that owns the grab.
    property <string> drag-id;
    property <bool> list-dragging: false;
    // (#slot-shift-same-group 2026-09-07) 被拖行的组:让位仅在同组内进行。
    // 行间距在同组内均匀(行高+2px),但组与组之间隔组头壳(38px)+8px
    // padding——跨组"移一格"步长失配,成员必然撞进别的组/叠印在组头壳
    // 上(用户截图实锤)。跨组移动没有让位空档,落点指示交给组头命中
    // 高亮;异组行命中时 hole 上报 -1px,槽位框不画(框不压成员)。
    property <string> drag-group: "";
    // (#drag-stale-cancel 2026-09-07) 拖拽活跃态转发 + 外部取消入口:
    // 截图软件等全局工具会吃掉鼠标 up 事件,程序以为仍在拖拽,成员卡
    // 跟着鼠标继续漂。Rust 侧 150ms 轮询 GetAsyncKeyState(左键),发现
    // "拖拽中但左键实际已松开"即 invoke cancel-drag() 兜底清除。
    in-out property <bool> drag-active: root.list-dragging || root.group-dragging;
    // (#drag-fly-home 2026-09-10) 取消拖拽(Esc/右键/切窗/左键异常松开,
    // Rust 150ms 轮询触发)的归位动画窗口:指示态立即清、本体行立即复现,
    // ghost 以 180ms 飞回 drag-origin-y;期间行命中停报、让位冻结;200ms
    // 后 Timer 统一清剩余拖拽态。
    property <bool> drag-fly-home: false;
    // (#drag-fly-home-r3 2026-09-10) Rust→UI 取消通路。原设计里回调
    // cancel-drag 的绑定向是 welcome→AppWindow(只把"取消"转发给 Rust),
    // 而 Rust 侧 invoke_cancel_session_drag() 触发的 AppWindow.
    // cancel-session-drag 回调【没有任何处理者】—— 取消请求从未抵达本页
    // 的取消逻辑,这才是"Esc/右键/切窗都不归位、拖拽态残留到卡死"的
    // 真正根因。改用计数器属性:Rust 每次请求取消即把 AppWindow 的
    // session-drag-cancel-seq +1,经实例绑定传入本属性;changed 内部触发
    // cancel-drag,完整复用既有取消/归位逻辑(重复触发由 drag-fly-home
    // 幂等把关)。
    in property <int> drag-cancel-seq: 0;
    changed drag-cancel-seq => {
        root.cancel-drag();
    }
    callback cancel-drag();
    // (#drag-ghost 2026-09-06) ghost 浮动卡的内容快照与原槽 y(列表内容
    // 坐标),drag-start 时一次性捕获;ghost 元素见列表末尾(tabs #408 同款:
    // 本体隐形留洞,唯一跟手元素是 ghost)。
    property <string> drag-name: "";
    property <string> drag-host: "";
    property <int> drag-conn: 0;
    property <bool> drag-builtin: false;
    property <length> drag-origin-y: 0px;
    // (#drag-autoscroll 2026-09-07) 拖拽期间的累计自动滚动量(内容坐标)。
    // 指针在屏幕上的位移 dy 与列表滚动是两个独立自由度:滚了 Δ 之后,同一
    // 屏幕位置对应的内容坐标也 +Δ,不累加就会"指针走了、落点没走"。
    property <length> drag-scroll-dy: 0px;
    // (#drag-tail-drop-r2 2026-09-07) 顶部越界状态位:旧方案由行 changed 钩子
    // 广播 head id,依赖"触发顺序 = 模型顺序"——Slint 不保证,反序时落位错乱。
    // 现在只上报布尔状态,精确落点由 Rust 的 move-session-to-start 按存储
    // 顺序计算。
    // (#drag-ungroup-pop 2026-09-07) 底部越界恢复为"移出分组"一档(r3 的
    // 48px 两档与文字提示带已废弃):越过列表内容底 = group 清空、挪到未分组
    // 平铺区;视觉反馈由 ghost 卡去缩进 + accent 描边的"升级顶层"变形承担,
    // 不再有文字提示带与额外色带。
    property <bool> drop-over-head: false;
    property <bool> drop-over-ungroup: false;
    // (#group-head-exit-two-state-r3 2026-09-08) 上移方向组间过渡状态机
    // (用户定稿规范):
    //   待出组(pending):成员【顶边】接触本组组名下边 = ghost 与本组组头
    //     壳几何相交 → ghost 组别样式无框,本组组名亮蓝框;松手回原位。
    //   出组(out):成员【底边】离开本组组名上边(ghost 完全高于组头壳)
    //     → ghost 组别样式 + accent 蓝框,组名蓝框灭;松手移出分组。
    //   入组:上移碰到上一组最后成员(展开,行命中接管,走组内规则)或
    //     上一组组名(折叠,gh-overlap 进组第一位)→ 两态解除。
    // owner 模式规避多组头实例 changed 触发顺序不可靠的老坑。
    property <bool> drop-over-out: false;
    property <string> drop-over-out-owner: "";
    // (#current-group 2026-09-10) ghost 【当前所处的组】:把拖拽状态机里的
    // "本组"泛化。从下方组上移、从尾部进入另一个展开组后,该组即"当前组";
    // ghost 继续上行到它的组名下边 = 待出组(pending)、ghost 底离开组名上边
    // = 出组(out) —— 与本组完全同一套状态机(用户定稿)。初始 = 拖起行所属组
    // (drag-start 写入);任何组头在前导边落入其区间时上报覆盖;拖起/松手/
    // 取消清空。builtin(本地终端)与 default(未分组)不算"组别",不上报 ——
    // 于是第一组成员出组后 current 停在该组,出组态一直亮(上方 builtin 不可入)。
    property <string> drag-current-group: "";
    callback current-group-report(string /* group */);
    current-group-report(g) => { root.drag-current-group = g; }
    property <bool> drop-over-pending: false;
    property <string> drop-over-pending-owner: "";
    // (#exit-two-state-r4 2026-09-08) 成员排序模式:行命中(含底缘入组接
    // 管)置 true,离开成员行(drop-leave)/顶部越界/底部越界/拖拽起止清
    // false。pending/out 的几何表达式织入此标志——否则接管清掉两态后,
    // 几何恒真而值不再变化,changed 永不再触发,出组态/待出组无法随
    // ghost 位置重新亮起(跨组上移出组态残留、组名蓝框不灭的根源)。
    property <bool> drag-in-member-mode: false;
    // (#ghost-band 2026-09-07) 落点层级上报:ghost 卡样式(顶层 / 组内成员)
    // 依附于【当前落点所在行】的 group,由命中行写入。旧 cross-group-mid
    // "无组别中间态"已整体退役:上移越组的出口交给行落点(drop-report,
    // 目标行的 group 决定松手后的归属)+ 顶部越界(over-head)两条通路,
    // 不再需要单独的中间态位。
    property <string> drag-drop-group: "";
    // 上报行 id:多实例 changed 的触发顺序不可靠,离场时只清"自己写的"
    // (比较 owner),避免 A 行刚写的值被 B 行的离场分支误清。
    property <string> drag-drop-owner: "";
    // (#bottom-ingress 2026-09-08) 底缘入组候选仲裁:上移跨组、ghost 顶
    // 悬在目标组组名下方间隙时,异组成员行经 bottom-report 上报候选。
    // 16ms Timer 仲裁——本周期内若有过顶基准命中(top-tick 变化)则丢弃
    // 候选(顶优先),否则采纳:清出组/待出组/组头态,落点 = 候选行之前
    // (= 目标组末位入口),ghost 样式经 ddg 切回成员样式。
    // (#out-keep 2026-09-09) 出组态(out)禁止采纳:用户定稿出组后 ghost
    // 要持续亮蓝框直到松手(移出分组)或拖到列表顶(移到首位);否则上移
    // 途中 ghost 底扫过任何异组成员行(如未分组平铺行)都会被仲裁吸走,
    // 出组蓝框一闪即逝、"1 号成员上移无出组状态"(用户实测)。出组后想
    // 进上一组走下移方向行命中接管(定稿:上移行命中在 out 态被吞报)。
    property <string> bottom-candidate: "";
    property <string> bottom-candidate-group: "";
    // (#ghost-pill) 底缘候选的位次(加入该组末尾 = 组大小 + 1)。
    property <int> bottom-candidate-pos: 1;
    property <int> top-hit-tick: 0;
    property <int> last-top-tick: -1;
    Timer {
        interval: 16ms;
        running: root.list-dragging;
        triggered => {
            if (root.bottom-candidate != "" && root.top-hit-tick == root.last-top-tick
                    && !root.drop-over-out) {
                root.drop-over-out = false;
                root.drop-over-out-owner = "";
                root.drop-over-pending = false;
                root.drop-over-pending-owner = "";
                root.drop-over-group = "";
                root.drop-over-group-owner = "";
                root.drop-target-id = root.bottom-candidate;
                root.drop-after = false;
                // (#ghost-pill) 底缘采纳同样写落点快照(位次 = 该组末尾)。
                root.drop-target-group = root.bottom-candidate-group;
                root.drop-target-pos = root.bottom-candidate-pos;
                root.drag-drop-group = root.bottom-candidate-group;
                root.drag-drop-owner = root.bottom-candidate;
                // (#bottom-ingress) 采纳 = 进入成员排序模式。
                root.drag-in-member-mode = true;
            }
            root.last-top-tick = root.top-hit-tick;
            root.bottom-candidate = "";
        }
    }
    // (#drag-hover-expand) 悬停展开两段转发的中转:行内 Timer 只置此串,
    // 顶层 16ms Timer 真正调用 toggle-group,确保模型重建不发生在行组件
    // 的回调栈内。
    property <string> pending-expand-group: "";
    Timer {
        interval: 16ms;
        running: root.pending-expand-group != "";
        triggered => {
            root.toggle-group(root.pending-expand-group);
            root.pending-expand-group = "";
        }
    }
    // (#group-head-directional 2026-09-08) ghost 与组头行接触(上移顶边压住
    // 组头 / 下移底边接触组头)或已越过组头行 = 进该组第一位。由 gh-shell
    // 的 gh-overlap / gh-enter 几何判定上报(owner 模式)。
    property <string> drop-over-group: "";
    property <string> drop-over-group-owner: "";
    // (#group-drag-collapse 2026-09-08) 拖起自动折叠:组头拖动启动时记录
    // 被拖组名,该组成员行在拖拽期间隐藏(组视觉折叠为一行)——展开大组
    // 与折叠组获得统一的行级换位手感(VS Code 拖文件夹同款);松手/取消
    // 即恢复成员显示,不改用户的折叠记录。
    property <string> group-drag-collapse: "";
    // (#ctx-menu-pin-r2 2026-09-08) 右键菜单高亮的全局单值 key:成员行 =
    // session.id,组头 = "hdr:"+group-header。同一时刻至多一个菜单高亮,
    // 右击新行自动顶掉旧行。(#ctx-menu-backdrop) 弹层迁 AppWindow 根后,
    // key 非空即菜单开着,点 backdrop 清空。
    in-out property <string> ctx-open-key: "";
    // (#ctx-menu-backdrop 2026-09-08) 集中弹层的状态(AppWindow 根渲染):
    // 菜单种类("row" 成员菜单 / "group" 组头菜单)、被右击对象数据、点击点
    // 窗口坐标、点击点到快速连接面板底的余量(浮层据此上翻)。
    in-out property <string> ctx-menu-kind: "";
    in-out property <string> ctx-menu-group: "";
    in-out property <bool> ctx-menu-empty: false;   // 组头菜单:空组才有"删除"
    in-out property <length> ctx-menu-x: 0px;
    in-out property <length> ctx-menu-y: 0px;
    in-out property <length> ctx-menu-space-below: 0px;
    // (#ctx-menu-autoclose 2026-09-09) 被右击的触发行矩形(窗口坐标):菜单
    // 打开期间,该行 ∪ 菜单本体构成"安全区"——指针在安全区内菜单稳定,
    // 离开安全区(app.slint 探测层判定,150ms 防抖)自动关闭。右击时随
    // ctx-opening 链/组头分支写入。
    in-out property <length> ctx-row-x: 0px;
    in-out property <length> ctx-row-y: 0px;
    in-out property <length> ctx-row-w: 0px;
    in-out property <length> ctx-row-h: 0px;
    // (#ctx-menu-autoclose) 行命中注册表(Rust 侧 VecModel 维护)+ 注册回调:
    // 菜单打开时各可见行/组头经 changed ctx-open-key 注册自身;backdrop
    // 右击调 hit-ctx-row 命中后一步换菜单。ctx-gen = 打开代数(命中过滤)。
    in-out property <[CtxRowHit]> ctx-rows;
    callback reg-ctx-row(CtxRowHit);
    in-out property <int> ctx-gen: 0;
    // (#drag-stale-click 2026-09-07) 拖拽中切窗口(截图/看消息)再切回,
    // 系统不会补发 pointer cancel,list-dragging 残留、ghost 钉在原地。
    // 用户下一次按下被 down 分支的 stale-drag 清理逻辑吃掉(drag-end),
    // 但松开时 pressing && !grab-dragging 仍会 connect——"点一下却打开了
    // 终端"。此标志把那一次点击标记为"仅清残留",松开不触发连接。
    property <bool> drag-cancel-pending: false;
    // (#drag-deferred-commit 2026-09-07) 松手提交延后一拍:drag-end 回调里
    // 同步重建模型会销毁正在执行回调的行(Slint 中回调期触自身销毁是往上
    // 拖卡死的头号嫌疑)。这里只存参数,由 0ms Timer 在下一轮事件循环分派。
    property <string> commit-op: "";    // "" | "to" | "start" | "group" | "ungroup"
    property <string> commit-id;
    property <string> commit-target;
    property <bool> commit-after: false;
    property <string> commit-group;
    callback toggle-group(string /* group */);
    callback new-group();
    callback edit-group(string /* current-name */);
    callback delete-group(string /* name */);
    callback remove-session(string);
    // (#drag-tail-drop-r2 2026-09-07) 顶部越界落位,目标由 Rust 端计算。
    callback move-session-to-start(string);
    // (#group-head-directional 2026-09-08) 进该组第一位;空组直接改组。
    callback move-session-to-group-top(string /* id */, string /* group */);
    // (#drag-ungroup-pop) 移出分组:group 清空,挪到未分组平铺区。
    callback move-session-ungroup(string);
    callback search-changed(string);
    callback cycle-tab(bool /* reverse */);
    // Compact mode (welcome-as-sidebar): drop the big title/tagline header and
    // tighten padding so the session list fits a narrow docked panel (#v0.5).
    in property <bool> compact;
    in property <string> dock-edge: "left";
    property <bool> dock-horizontal: root.dock-edge == "left" || root.dock-edge == "right";
    // Collapse the sidebar to the edge icon strip (compact mode only) (#v0.5 M5).
    callback collapse();
    callback dock-drag-move(length, length);
    callback dock-drag-end();

    background: Theme.bg-root;

    // (#drag-deferred-commit 2026-09-07) 延迟提交分派:running 绑 commit-op,
    // triggered 里先清 op 再执行,防重入。0ms = 下一轮事件循环,模型重建时
    // drag-end 回调栈早已退栈,行销毁不再发生在回调执行途中。
    Timer {
        interval: 0ms;
        running: root.commit-op != "";
        triggered => {
            let op = root.commit-op;
            root.commit-op = "";
            if (op == "group") {
                root.move-session-to-group-top(root.commit-id, root.commit-group);
            } else if (op == "ungroup") {
                root.move-session-ungroup(root.commit-id);
            } else if (op == "start") {
                root.move-session-to-start(root.commit-id);
            } else if (op == "to") {
                root.move-session-to(root.commit-id, root.commit-target, root.commit-after);
            }
        }
    }
    // (#drag-stale-cancel) 外部取消入口。(#drag-fly-home 2026-09-10) 取消
    // 改两段式:拖拽中先只清指示/两态/落点(让位蓝框同步复位、本体行经
    // fly-home 门控立即复现),保留 list/group-dragging 与 drag-id 让 ghost
    // 飞回原槽;落地 Timer 再清剩余态。group-drag-collapse 留到落地才清
    // (折叠组整组飞回后再展开成员)。非拖拽态的冗余调用走 else 全清兜底。
    cancel-drag => {
        // (#drag-fly-home-r2 2026-09-10) 幂等保护:归位窗口期内重复取消直接
        // 忽略。根因——Rust 150ms 轮询在【窗口失焦 / 被全局工具抢焦点】
        // 期间会持续上报取消;而取消后 list/group-dragging 故意保留
        // 200ms 让 ghost 飞回,该窗口内 drag-active 仍为 true → 每 150ms
        // 又取消一次。若每次都重跑分支并重新给 drag-fly-home 赋值,会反复
        // 扰动落地 Timer 的 running 绑定、令 200ms Timer 不断被重置而永不
        // 触发 → ghost 永停半空、本体恒为洞、行命中被 !drag-fly-home 门控
        // 全部吞掉 = 卡死。落地 Timer 会自行收尾,无需重复驱动。
        if (root.drag-fly-home) {
            return;
        }
        // (#current-group 2026-09-10) 取消即清"当前所处组"。
        root.drag-current-group = "";
        if (root.list-dragging || root.group-dragging) {
            root.drag-fly-home = true;
            root.drop-over-head = false;
            root.drop-over-ungroup = false;
            root.drop-over-out = false;
            root.drop-over-out-owner = "";
            root.drop-over-pending = false;
            root.drop-over-pending-owner = "";
            root.drop-over-group = "";
            root.drop-over-group-owner = "";
            root.drag-drop-group = "";
            root.drag-drop-owner = "";
            root.drag-in-member-mode = false;
            root.drop-target-id = "";
            root.drop-after = false;
            root.drop-target-group = "";
            root.drop-target-pos = 1;
            root.commit-op = "";
        } else {
            root.list-dragging = false;
            root.group-dragging = false;
            root.group-drag-id = "";
            root.group-dy = 0px;
            root.group-drag-collapse = "";
            root.drop-over-head = false;
            root.drop-over-ungroup = false;
            root.drop-over-out = false;
            root.drop-over-out-owner = "";
            root.drop-over-pending = false;
            root.drop-over-pending-owner = "";
            root.drop-over-group = "";
            root.drop-over-group-owner = "";
            root.drag-drop-group = "";
            root.drag-drop-owner = "";
            root.drag-in-member-mode = false;
            root.drop-target-id = "";
            root.drop-after = false;
            root.drop-target-group = "";
            root.drop-target-pos = 1;
            root.drag-id = "";
            root.commit-op = "";
            root.drag-dy = 0px;
            root.drag-scroll-dy = 0px;
        }
    }
    // (#drag-fly-home) 归位落地:ghost 飞回原槽(180ms)后统一清态,本体行
    // 随 list-dragging=false 恢复交互,group 成员行随 collapse 清除重新展开。
    // (#ease-align-spec 2026-09-10) 200ms = 180ms 动画 + 20ms 缓冲(原 220)。
    Timer {
        interval: 200ms;
        running: root.drag-fly-home;
        triggered => {
            root.drag-fly-home = false;
            root.list-dragging = false;
            root.group-dragging = false;
            root.group-drag-id = "";
            root.group-dy = 0px;
            root.group-drag-collapse = "";
            root.drag-id = "";
            root.drag-dy = 0px;
            root.drag-scroll-dy = 0px;
        }
    }

    // (#dwell-collapse 2026-09-10) 「只是路过」的临时展开组要恢复原状——
    // 规格 §3.3 细则:展开后不立即收起,拖离 300ms 且**是拖拽临时展开的**
    // 才收起(否则路过几个折叠组就把整个列表摊开了,原实现缺这条,展开后
    // 永久保持)。
    // 判定:记下 dwell 展开过的组;"离开它"= drag-current-group(ghost 当前
    // 所处的组,任一时刻至多命中一个)不再是它。若 ghost 又回到该组(用户
    // 其实要拖进去),running 立刻转 false、Timer 复位,不会把目标组收掉。
    property <string> drag-expanded-group: "";
    Timer {
        interval: 300ms;
        // 拖动中:ghost 已离开该组 → 计时收起。
        // 已松手/已取消(!list-dragging):也要收(drag-end 不能直接调
        // toggle-group —— 那会在行的回调栈里重建模型、销毁本行)。
        running: root.drag-expanded-group != ""
            && (!root.list-dragging
                || root.drag-current-group != root.drag-expanded-group);
        triggered => {
            // 经 Timer 调用 = 脱离行的回调栈(拖拽中模型重建不会销毁调用者),
            // 与 #drag-hover-expand 的 pending-expand 转发同理。
            root.toggle-group(root.drag-expanded-group);
            root.drag-expanded-group = "";
        }
    }

    // The regular welcome page is itself a tab. When Ctrl+Tab wraps from the
    // last terminal to this page, keep the shortcut chain alive so the next
    // press can continue to the first terminal (#294). The compact welcome
    // sidebar must never take focus away from an active terminal. Windows
    // AccessKit may instantiate this conditional scope while walking the
    // accessibility tree, so defer focus to the next event-loop turn instead of
    // re-entering Slint's winit adapter from `init` (#323).
    if !root.compact : welcome-key-scope := FocusScope {
        property <bool> focus-pending: false;
        init => { self.focus-pending = true; }
        Timer {
            interval: 0ms;
            running: welcome-key-scope.focus-pending;
            triggered => {
                welcome-key-scope.focus-pending = false;
                welcome-key-scope.focus();
            }
        }
        key-pressed(event) => {
            if ((Theme.is-mac ? event.modifiers.meta : event.modifiers.control)
                    && (event.text == Key.Tab || event.text == Key.Backtab)) {
                root.cycle-tab(event.modifiers.shift || event.text == Key.Backtab);
                accept
            } else {
                reject
            }
        }
    }

    // (#welcome-fill 2026-09-05) Quick Connect 卡改为绝对定位铺满:红/绿标
    // 记实验证实 Rectangle 里的 VerticalLayout 会收缩到内容首选高度,且显式
    // height / min-height 均无法覆盖(布局引擎行为),卡片高度因此缩水、与
    // 右侧资源面板不一致。卡片直接绑定根尺寸;卡内改为固定 y 的绝对分区
    // (头部 / 新建按钮 / 搜索 / 列表),列表高度显式绑定剩余空间。
    if !root.compact : Rectangle {
        x: 24px;
        y: 24px;
        width: parent.width - 48px;
        height: 66px;
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "meatshell";
                color: Theme.text-primary;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: @tr("A lightweight and efficient Rust + Slint SSH client");
                color: Theme.text-secondary;
                font-size: Theme.fs-md;
                wrap: no-wrap;
            }
        }
    }

    // Quick Connect card — fills the remaining height so the panel doesn't
    // jump when the first session is added (#214); see #welcome-fill above.
    Rectangle {
        x: root.compact ? 12px : 24px;
        y: root.compact ? 12px : 106px;
        width: parent.width - (root.compact ? 24px : 48px);
        height: parent.height - (root.compact ? 24px : 130px);
        background: Theme.bg-panel;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-subtle;

        // 头部行(绝对 y=12,高 30,容纳 30px 的主按钮)。
        Rectangle {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: 30px;
                    TouchArea {
                        enabled: root.compact;
                        mouse-cursor: move;
                        moved => {
                            root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                        }
                    }
                    header-row := HorizontalLayout {
                        spacing: 8px;
                        if root.compact && root.dock-edge != "left" : CollapseButton {
                            glyph: root.dock-edge == "right" ? "\u{E5CC}"
                                 : root.dock-edge == "top" ? "\u{E5CE}"
                                 : "\u{E5CF}";
                            clicked => { root.collapse(); }
                        }
                        Text {
                            text: @tr("Quick connect");
                            color: Theme.text-primary;
                            font-size: Theme.fs-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.compact && root.dock-edge == "left" : CollapseButton {
                            glyph: "\u{E5CB}";
                            clicked => { root.collapse(); }
                        }
                        Text {
                            text: root.import-hint;
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                        if !root.compact : PrimaryButton {
                            text: @tr("+ New session");
                            clicked => { root.new-session(); }
                        }
                    }
                }
                if root.compact : PrimaryButton {
                    x: 16px;
                    y: 50px;
                    width: parent.width - 32px;
                    height: 30px;
                    text: @tr("+ New session");
                    clicked => { root.new-session(); }
                }

                // Filter saved and built-in sessions by display name or host.
                Rectangle {
                    x: 16px;
                    y: root.compact ? 88px : 50px;
                    width: parent.width - 32px;
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent : Theme.border-subtle;
                    background: Theme.bg-root;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 6px;

                        Text {
                            text: "\u{E8B6}";
                            font-family: "Material Icons";
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;

                            search-input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> root.search-query;
                                color: Theme.text-primary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                single-line: true;
                                edited => { root.search-changed(root.search-query); }
                            }

                            if root.search-query == "" : Text {
                                width: parent.width;
                                height: parent.height;
                                text: @tr("Search by name or host...");
                                color: Theme.text-muted;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }

                        if root.search-query != "" : Rectangle {
                            width: 24px;
                            height: parent.height;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: Theme.radius-sm;
                                background: clear-search.has-hover ? Theme.bg-hover : transparent;
                                accessible-role: button;
                                accessible-label: @tr("Clear search");

                                Text {
                                    text: "\u{E5CD}";
                                    font-family: "Material Icons";
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                clear-search := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.search-query = "";
                                        root.search-changed("");
                                        search-input.focus();
                                    }
                                }

                                if clear-search.has-hover : Rectangle {
                                    x: parent.width - self.width;
                                    y: parent.height + 4px;
                                    width: clear-search-tip.preferred-width + 16px;
                                    height: 22px;
                                    background: Theme.bg-elevated;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #00000070;

                                    clear-search-tip := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: @tr("Clear search");
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-xs;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                if sessions.length == 0 : Rectangle {
                    x: 16px;
                    y: root.compact ? 128px : 90px;
                    width: parent.width - 32px;
                    height: parent.height - (root.compact ? 144px : 106px);
                    background: Theme.bg-root;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: root.search-query == ""
                                ? @tr("No sessions yet")
                                : @tr("No matching sessions");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                        }
                        if root.search-query == "" : Text {
                            text: @tr("Use 'New session' (top-right) to add your first server");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                        }
                    }
                }

                if sessions.length > 0 : list-host := Rectangle {
                    // (#drag-ghost-pointer 2026-09-06) ghost 中心 y(列表内容
                    // 坐标,钳制在内容区内)。声明在本条件子树内因为计算依赖
                    // sess-list.preferred-height(条件作用域外不可见);行与
                    // ghost 都经实例绑定读取。
                    // (#drag-ghost-pointer 2026-09-06) ghost-y 不再在 init 期读
                    // sess-list.preferred-height —— 否则 ghost-over 在 init 被非
                    // 短路 && 拉取 ghost-y → 读 preferred-height → 触发 sess-list
                    // 布局 → 布局中又渲染 srow 再次求值 ghost-over → 重入
                    // ghost-y/preferred-height → "Recursion detected" panic(本包
                    // "无法打开"根因之二;slot-y 的 absolute-position 是根因之一)。
                    // 改用 self.height(= 列表可视高度,父传,非递归)做钳制上限,
                    // 几何稳定且语义正确(ghost 本就不该超出可视区)。
                    // (#drag-pointer-geom 2026-09-07) 判定与显示彻底解耦:
                    //   drag-pointer-y —— 未钳制的指针内容 y,落点判定唯一真源;
                    //   ghost-y       —— 钳制后的卡片显示位置,不参与任何判定。
                    // 旧实现拿钳制后的 ghost 中心去判定,而钳制上限是【可视高
                    // 度】、被比较的 slot-y 却是【内容坐标】:列表一滚动,内容
                    // 坐标远大于可视高度,落点被死死钉在首尾两行、拖过头也不
                    // 变——"首尾粘住""长列表拖不到位"的公共根因。
                    property <length> drag-pointer-y:
                        root.drag-origin-y + root.drag-dy + root.drag-scroll-dy;
                    // 显示钳制:内容区 (#slot-y-deferred-r2 2026-09-07)。
                    // r4 曾把上限改成可视高度 self.height——但指针坐标是内容
                    // 坐标,列表滚动过内容远大于可视区:从上往下拖进下半部分
                    // 时 ghost 被钳在可视区底"钉死不跟手",从下往上(上半区)
                    // 却正常——正是用户反馈的方向不对称。恢复内容高度上限,
                    // ghost 全程跟手;底部越界判定用的 drag-pointer-y 本就
                    // 未钳制,不受影响。
                    // (#ghost-ungroup-follow 2026-09-07) 出组态放开钳制:ghost
                    // 卡原钳制上限是"sess-list 内容底 - 卡高",而底部越界
                    // (over-ungroup)判定恰好在指针到达该上限时翻转——蓝框
                    // 一亮卡片就停住,观感"到底了不许再动"。出组判定为真后
                    // 不再钳制,卡片继续跟手滑出列表底部(由 list-host clip
                    // 自然裁切),"滑出列表"本身就对应"移出分组"的语义;
                    // 非出组态保持原钳制,拖不出边界。
                    // (#ghost-panel-bound 2026-09-07) 钳制到面板可视边界:
                    // 可视顶内容坐标 = -viewport-y(viewport-y ≤ 0),可视底 =
                    // -viewport-y + flick.height;再与内容底取小,列表短于面板
                    // 时不超内容底。
                    // (#ghost-ungroup-follow-r2 2026-09-07) 出组态不再完全放
                    // 开——上一版"直接跟 pointer"会让卡片整张滑出列表底"消
                    // 失"(用户实测)。改为收进半格:卡底最多探出内容底半个
                    // 卡高,蓝框始终可见,且从翻转点起仍能继续跟手半格。
                    property <length> ghost-h: max(1px, root.drag-pitch - 2px);
                    property <length> ghost-y: clamp(
                        self.drag-pointer-y,
                        max(0px, -flick.viewport-y),
                        max(max(0px, -flick.viewport-y),
                            // (#ghost-bottom-limit 2026-09-08) 下移最低限 =
                            // 面板可视底:出组态钳制上限改为可视底(ghost 底
                            // 贴面板底),不再受内容底限制、不再探出半格
                            // (r2 的"滑出半格"用户实测后定稿取消——最低限
                            // 就是面板底部)。非出组态保持 min(可视底, 内容底)。
                            (root.drop-over-ungroup
                                ? -flick.viewport-y + flick.height
                                : min(-flick.viewport-y + flick.height, sess-list.preferred-height))
                            - self.ghost-h));
                    x: 16px;
                    y: root.compact ? 128px : 90px;
                    width: parent.width - 32px;
                    height: parent.height - (root.compact ? 144px : 106px);
                    clip: true;
                    // (#session-scrollbar 2026-09-05) std ScrollView 的原生滚动
                    // 条与全局自绘细条(终端那套)风格不一致;改为 Flickable +
                    // 自绘 4px overlay 细条。interactive 必须关:interactive 的
                    // Flickable 会延迟子元素 press 并在移动 8px 后抢走手势,成
                    // 员行的拖拽重排会被误判成滚动(tabs.slint #408 同款结论);
                    // 关闭后滚轮/触控板滚动仍由 Flickable 处理,拖滚动条走自绘。
                    flick := Flickable {
                        interactive: false;
                        viewport-width: self.width;
                        viewport-height: max(self.height, sess-list.preferred-height);
                    sess-list := VerticalLayout {
                    spacing: 0px;
                    for session[i] in sessions : VerticalLayout {
                        // Exclude hidden rows from layout spacing while a group
                        // is collapsed; keep its first row for the group header.
                        visible: session.group-header != "" || !session.collapsed;
                        // (#session-tree-hierarchy 2026-09-04) 层级 = 组间 ≥ 组内:
                        // 分组之间 12px 拉开,组头与成员、成员与成员之间收紧到
                        // 2px,配合成员缩进 + 树形引导线,父子关系一目了然。
                        // (旧值 #group-header-larger:padding-top 6px / spacing 8px,
                        // 组内比组间还松,层级倒置。)
                        // (#session-tree-hierarchy-r2) 关键修复:padding-top 的
                        // 条件补上 `group-header != ""`。旧条件只有 `i > 0`,
                        // 会把组间距错误地加在**每个成员行迭代**上——组内成员
                        // 之间因此多出无意义空隙。
                        // (#session-tree-hierarchy-r5 2026-09-05) 间距恒定 8px:
                        // r3 的"折叠 4px/展开 12px"自适应会随点击收展跳变,导致
                        // 点击的组自身上下位移(用户反馈);固定值消除跳变。
                        padding-top: self.visible && session.group-header != "" && i > 0 ? 8px : 0px;
                        spacing: 2px;
                        // Group header on the first row of each group (#41).
                        // Click anywhere on it to collapse / expand the group.
                        if session.group-header != "" : gh-shell := Rectangle {
                            // 外壳:在 VerticalLayout 里占位(38px);跟手位移、
                            // 背景等全部在内层 gh-card 上(布局子项不可设 y)。
                            // (#group-drag-reorder 2026-09-06) 组头可拖动排序:
                            // 垂直拖动 >5px 启动,内层卡片跟手浮起,松手按方向
                            // 相邻换位(±20px 阈值,一次一位;explicit groups
                            // 的存储顺序即显示顺序)。拖动后不触发折叠 toggle。
                            // (#drag-group-head-geom 2026-09-07) 组头落点判定
                            // 改为指针几何,废弃 grp-ta.has-hover 上报:拖拽期间
                            // 指针 grab 被被拖行的 TouchArea 持有,winit 把
                            // motion 只派发给 grab 持有者,其它 TouchArea 的
                            // has-hover 冻结——"拖到组头无高亮、松手进不了组"
                            // 的根因。几何判定只读指针内容坐标,不依赖事件
                            // 派发,拖拽中恒有效。
                            // gh-slot-y 必须走 changed 写入(同 srow.slot-y):
                            // init 期读自身几何会触发 Recursion panic(6e245ea)。
                            property <bool> drag-live: root.list-dragging;
                            // (#slot-y-deferred-r3) 同步写入,同 srow 侧结论:
                            // Timer 延迟模式在 slint 1.8 不触发,回到稳定模式。
                            changed drag-live => {
                                if (self.drag-live) {
                                    self.gh-slot-y =
                                        self.absolute-position.y - sess-list.absolute-position.y;
                                }
                            }
                            property <length> gh-slot-y: 0px;
                            // (#cross-group-shift 2026-09-07) 组名让位:与成员
                            // 行 shift-y 完全同式(下移看 ghost 底、上移看 ghost
                            // 顶,越过组头中线即让位整格),只是基准换成 gh-slot-y。
                            // 组头项同时含 gh-card 与本行 srow,两者同步位移才
                            // 不会"组名与首行分离"——这正是旧代码禁止组头让位
                            // 的原因;同步后约束消失,跨组时组名也跟着让位。
                            property <length> gh-shift-y:
                                !root.list-dragging || root.drag-id == ""
                                || session.builtin || root.drag-fly-home ? 0px
                                // (#pending-group-yield r4 2026-09-10) 本组组头让位
                                // 阈值收紧到【ghost 顶接触组名下边】。r3 用"首成员行
                                // 中线"(slot+40+half)触发过早——ghost 顶还没碰到组名
                                // 下边时组名就下移,与首成员叠成"一体"(用户截图)。
                                // 改回几何真值:ghost 顶(= 指针)越过组名下边(slot+38)
                                // 才下移一格并【保持】,回落(入组)才归 0。
                                : session.group == root.drag-group
                                    ? ((list-host.drag-pointer-y < root.drag-origin-y
                                            && list-host.drag-pointer-y <= self.gh-slot-y + 38px)
                                        ? root.drag-pitch : 0px)
                                // (#pending-group-yield r4) 异组组头让位与成员行同向
                                // 同幅:
                                //   下移入组(组名在被拖行下方,指针已到本组组名中线)
                                //   → 组名上移一格让位(与成员行 slot-y>origin 分支同
                                //   式);r3 曾整条删除"上移让位",导致"下移入组时组名
                                //   不动"(用户截图)。加 pointer>origin 前提以排除【上移】
                                //   时的误命中(r2"组名与 ghost 重叠"即此因)。
                                //   上移入组(组名在被拖行上方,指针已到本组组名中线)
                                //   → 组名下移一格让位。
                                : self.gh-slot-y > root.drag-origin-y
                                    && list-host.drag-pointer-y > root.drag-origin-y
                                    && list-host.drag-pointer-y > self.gh-slot-y - ((root.drag-pitch - 2px) / 2)
                                    ? -(root.drag-pitch)
                                : self.gh-slot-y < root.drag-origin-y
                                    && list-host.drag-pointer-y < self.gh-slot-y + ((root.drag-pitch - 2px) / 2)
                                    ? root.drag-pitch
                                : 0px;
                            // (#group-head-directional 2026-09-08) 旧 gh-hit
                            // (压组头 = 进组第一位)整体退役:组头行区间曾与
                            // 出组中间态争用同一几何,来回拖动时两套蓝框反复
                            // 跳变、changed 置清交错产生概率性错误状态(用户
                            // 实测)。改由 ghost 与组头行的几何关系
                            // (gh-overlap / gh-enter)统一判定。
                            // (#group-head-exit-two-state-r3 2026-09-08) 组头
                            // 几何判定按【拖动方向 + 是否本组组头】分派,实现
                            // 用户定稿的上移组间过渡状态机(底 = ghost 底缘 =
                            // pointer + pitch-2,顶 = ghost 顶缘 = pointer):
                            //   ① gh-overlap 底 ∈ (slot, slot+40) 且【异组】:
                            //      接触/压住组头 → 组头蓝框,松手 = 进该组第
                            //      一位。本组组头不触发(那是待出组的地盘)。
                            //   ② gh-out-pending 上移且本组组头,ghost 与壳
                            //      几何相交(顶 < slot+38 且 底 > slot):成员
                            //      顶边接触组名下边 → 待出组:ghost 组别样式
                            //      无框、本组组名亮蓝框;松手回原位。
                            //   ③ gh-out 上移且本组组头,ghost 底离开组名上边
                            //      (底 <= slot):出组 → ghost 组别样式 + accent
                            //      蓝框,组名蓝框灭;松手移出分组。
                            //   ④ gh-enter 底 ∈ [slot+76, slot+114) 且下移且
                            //      异组:进组过渡,松手 = 进该组第一位。
                            //   入组接管:展开组 = 成员行命中(drop-report)写
                            //   drag-drop-group 并清 pending/out;折叠组 =
                            //   gh-overlap(异组)。组间空隙保持出组态。
                            property <length> ghost-bottom:
                                list-host.drag-pointer-y + (root.drag-pitch - 2px);
                            property <bool> moving-up:
                                list-host.drag-pointer-y < root.drag-origin-y;
                            // (#current-group 2026-09-10) ghost 前导边(上移 = 顶
                            // = 指针;下移 = 底 = 指针 + 卡高,与行命中 drop-y 同式)。
                            property <length> aside-lead-y:
                                list-host.drag-pointer-y > root.drag-origin-y
                                    ? list-host.drag-pointer-y + (root.drag-pitch - 2px)
                                    : list-host.drag-pointer-y;
                            // (#current-group) ghost 前导边落入【本组区间】
                            // [组名顶, 组末底) → 本组即"ghost 当前所处的组",
                            // 上报覆盖。据此:从尾部进入另一个展开组后,该组按
                            // 与本组完全相同的 pending/out 状态机处理。builtin
                            // (本地终端)不是组别,不上报。
                            // (#default-group-drop 2026-09-10) 默认组现在是正式
                            // 组(有组头、可折叠、可作落点),同样参与上报:否则
                            // 从默认组上移时 current 恒为空,组头的 pending/out
                            // 判定永不成立,拖出默认组没有任何反馈。默认组成员
                            // 的 group 为空(由 != "" 排除);默认组【组头行】的
                            // group 是 "default",保留上报。
                            property <bool> ghost-in-current:
                                root.list-dragging && root.drag-id != ""
                                && !root.drag-fly-home
                                && session.group != ""
                                && !session.builtin
                                && self.aside-lead-y >= self.gh-slot-y
                                && self.aside-lead-y < self.gh-slot-y + 38px
                                    + (session.collapsed ? 0px
                                        : root.drag-pitch * session.group-size);
                            changed ghost-in-current => {
                                if (self.ghost-in-current) {
                                    root.current-group-report(session.group);
                                }
                            }
                            property <bool> gh-overlap:
                                root.list-dragging && root.drag-id != ""
                                && !root.drag-fly-home
                                && root.drag-group != session.group
                                // (#current-group 2026-09-10) 当前所处的组不参与
                                // "进组第一位":ghost 已在该组内,压它的组名属于
                                // "待出组/出组"的地盘(见 gh-out-pending / gh-out)。
                                && session.group != root.drag-current-group
                                // (#system-group-frozen 2026-09-08) 保留组
                                // (本地终端)整体冻结:组头不作进组目标。
                                && !session.builtin
                                && self.ghost-bottom > self.gh-slot-y
                                && self.ghost-bottom < self.gh-slot-y + 40px;
                            // (#gh-out-group-gate → #current-group 2026-09-10)
                            // 待出组/出组只属于【ghost 当前所处的组】的组头实例。
                            // 历史:曾按本组(drag-group)门控,因为 gh-out 的
                            // ghost-bottom <= gh-slot-y 无下界,列表更下方的组头
                            // 实例该条件恒真、会与本组 pending 同帧竞争(changed
                            // gh-out 的 true 分支无条件清 pending,out owner 被
                            // 劫持 → 组内上移直接跳成出组蓝框)。现门控换成
                            // drag-current-group:它由组头按"前导边落入本组区间"
                            // 上报,任一时刻**至多一组命中**,同样天然免争用;且
                            // 把"本组"泛化成"当前组"后,从尾部进入另一个展开组
                            // 也走完全相同的待出组/出组判定(用户定稿)。
                            property <bool> gh-out-pending:
                                root.list-dragging && root.drag-id != ""
                                && !root.drag-fly-home
                                && session.group == root.drag-current-group
                                && !root.drag-in-member-mode
                                // (#first-group-no-pending 2026-09-10) 列表最顶的
                                // 具名组跳过"待出组":其上方没有任何可进入的组,
                                // 上移不经 pending(组名亮蓝框 / 松手回原位),直接
                                // 进出组态(ghost = 蓝框 + 组别样式)。用户定稿。
                                && !session.first-group
                                && self.moving-up
                                // (#pending-deadzone 2026-09-09) 上界对齐首成员
                                // 行顶(slot+40=组头 38 + 行间距 2):原 38px 与
                                // 行命中带之间留 2px 死区,ghost 顶刚接触组名下
                                // 边时 pending 不亮、行也未命中(无状态抖动)。
                                // 与行命中重叠部分由 drag-in-member-mode 抑制。
                                && list-host.drag-pointer-y < self.gh-slot-y + 40px
                                && self.ghost-bottom > self.gh-slot-y;
                            property <bool> gh-out:
                                root.list-dragging && root.drag-id != ""
                                && !root.drag-fly-home
                                // (#current-group 2026-09-10) 当前所处的组:出组
                                // = ghost 底离开该组组名上边。第一组出组后
                                // current 不再变化(上方 builtin 不上报) → 出组态
                                // 一直保持;其余组出组后继续上行进入上一组 →
                                // current 切换到上一组 → 出组态自然交棒(用户定稿)。
                                && session.group == root.drag-current-group
                                && !root.drag-in-member-mode
                                && self.moving-up
                                && self.ghost-bottom <= self.gh-slot-y;
                            property <bool> gh-enter:
                                root.list-dragging && root.drag-id != ""
                                && !root.drag-fly-home
                                && list-host.drag-pointer-y > root.drag-origin-y
                                && root.drag-group != session.group
                                && !session.builtin
                                && self.ghost-bottom >= self.gh-slot-y + 76px
                                && self.ghost-bottom < self.gh-slot-y + 114px;
                            changed gh-overlap => {
                                if (self.gh-overlap) {
                                    root.drop-over-group = session.group;
                                    root.drop-over-group-owner = session.group;
                                } else if (root.drop-over-group-owner == session.group
                                    && !self.gh-enter) {
                                    root.drop-over-group = "";
                                    root.drop-over-group-owner = "";
                                }
                            }
                            changed gh-enter => {
                                if (self.gh-enter) {
                                    root.drop-over-group = session.group;
                                    root.drop-over-group-owner = session.group;
                                } else if (root.drop-over-group-owner == session.group
                                    && !self.gh-overlap) {
                                    root.drop-over-group = "";
                                    root.drop-over-group-owner = "";
                                }
                            }
                            // (#group-head-exit-two-state-r3) 待出组/出组上报
                            // (owner 模式)。两态几何互斥(相交带 vs 壳上方),
                            // 换带即前态自动清除;行命中接管时由 drop-report
                            // 统一清(入组)。
                            changed gh-out-pending => {
                                if (self.gh-out-pending) {
                                    root.drop-over-pending = true;
                                    root.drop-over-pending-owner = session.group;
                                } else if (root.drop-over-pending-owner == session.group) {
                                    root.drop-over-pending = false;
                                    root.drop-over-pending-owner = "";
                                }
                            }
                            changed gh-out => {
                                if (self.gh-out) {
                                    root.drop-over-out = true;
                                    root.drop-over-out-owner = session.group;
                                    // 出组时组名蓝框无条件熄灭(任意 owner):
                                    // 出组 = 已不在任何组内,待出组的组名框
                                    // 语义随之消失,反馈转移到 ghost 卡蓝框。
                                    root.drop-over-pending = false;
                                    root.drop-over-pending-owner = "";
                                } else if (root.drop-over-out-owner == session.group) {
                                    root.drop-over-out = false;
                                    root.drop-over-out-owner = "";
                                }
                            }
                            // (#drag-hover-expand 2026-09-07) 悬停收起组自动
                            // 展开:压住收起组头 600ms 触发。经 pending-expand
                            // 两段转发(顶层 16ms Timer 真正调用),脱离本行
                            // 回调栈——拖拽中模型重建会销毁本行,直接调用有
                            // "回调栈内销毁宿主"风险(#drag-deferred-commit 同因)。
                            // 展开后成员行出现,可继续拖入成员行之间进组。
                            Timer {
                                // (#dwell-prototype-align 2026-09-10) 150ms:
                                // 对齐交互原型。原 600ms 要压住组头停顿 0.6s
                                // 才展开,拖动中手感明显迟钝。
                                // auto-scroll 期间不累积:自动滚动是"穿过
                                // 列表"而不是"停留",不停下就展开会把沿途每个
                                // 折叠组都弹开(原型同款规则)。
                                interval: 150ms;
                                running: parent.gh-overlap && session.collapsed
                                    && flick.edge-step == 0px;
                                triggered => {
                                    // (#dwell-collapse) 记下"拖拽临时展开的组",
                                    // 供拖离 300ms / 终局时恢复折叠。
                                    root.pending-expand-group = session.group;
                                    root.drag-expanded-group = session.group;
                                }
                            }
                            height: 38px;
                            // (#group-sort-line 2026-09-10) 组排序**插入线**:
                            // 2px 主题色 + 两端圆点,画在**组与组之间的 8px 间隙**
                            // 里(不是行边)。位置吸附到整格:
                            //   round(dy / pitch) * pitch - 4px
                            // —— 吸附值就是松手时提交的换位数(同一个 round),
                            // 所见即所得;`-4px` 让线落在行顶上方的间隙中点,
                            // 与组头卡片脱开,避开 femtovg 邻接重绘的 1px 闪烁
                            // (spec §8:插入线不要贴行边画)。
                            // 只在【被拖的那一行】上渲染 → 全列表天然只有一条;
                            // 不可排序组(builtin / 默认组)不参与。
                            if root.group-dragging && !root.drag-fly-home
                                    && session.group == root.group-drag-id
                                    && !session.builtin
                                    && session.group != "default" : Rectangle {
                                y: Math.round(root.group-dy / root.drag-pitch)
                                    * root.drag-pitch - 4px;
                                x: 6px;
                                width: parent.width - 12px;
                                height: 2px;
                                border-radius: 1px;
                                background: Theme.accent-solid;
                                Rectangle {
                                    x: -3px; y: -2px;
                                    width: 6px; height: 6px;
                                    border-radius: 3px;
                                    background: Theme.accent-solid;
                                }
                                Rectangle {
                                    x: parent.width - 3px; y: -2px;
                                    width: 6px; height: 6px;
                                    border-radius: 3px;
                                    background: Theme.accent-solid;
                                }
                            }
                            gh-card := Rectangle {
                                // (#group-sort-line 2026-09-10) 组排序反馈**对齐交互
                                // 设计**(§2 / §3.2):被拖组**不搬动**(原型只把它
                                // 半透明),落点改由**组间插入线**表达——组是大块
                                // 结构,"整组跟着指针搬动"太晃眼、且拖起来像在
                                // 挪积木,与"用一条线克制表达"的设计相反。
                                // 历史:曾用"其它组头按方向让位一格"表达落点
                                // (#group-drag-collapse 2026-09-08)。它与插入线
                                // 语义重复、还让整列表一直在动,已整体退役。
                                // 现在只剩两态:成员行拖动 → 组头跟着成员让位
                                // (gh-shift-y);其余(含组头自身拖动)一律原地。
                                y: root.drag-fly-home ? 0px
                                    : (root.group-dragging ? 0px : parent.gh-shift-y);
                                // (#shift-drop-same-source) 让位/归位时长对齐
                                // 规格:让位 140ms(与成员行同步)、取消归位
                                // 180ms(§5「取消归位」,原 200ms)。
                                // (#drag-fly-home) 取消归位:被拖组头飞回原槽,
                                // 与 ghost 卡同一节奏。
                                animate y { duration: root.drag-fly-home ? 180ms
                                    : (root.group-dragging ? 0ms : 140ms);
                                    easing: cubic-bezier(0.22, 0.61, 0.36, 1); }
                                opacity: root.group-dragging && session.group == root.group-drag-id ? 0.92 : 1.0;
                                border-radius: Theme.radius-sm;
                                // (#drag-group-head-pop-r2 2026-09-07) 组头命中
                                // 样式收敛:accent 描边 + 淡底 + 浮起阴影,与
                                // 落点槽位框(#drop-slot-box)同一视觉语言。r1
                                // 的几何放大(x/width/height 外扩)让内容(布局
                                // 不随几何缩放)与外框脱节,观感"缺失完整度",
                                // 已移除;描边本身已足够醒目。
                                // (#group-head-exit-two-state-r4) 组头蓝框两个
                                // 归属:① 异组成员接触本组头(gh-overlap)= 进
                                // 组第一位;② 待出组(drop-over-pending,上移
                                // 顶边接触任意组名下边)= 提示"松手回原位"。
                                // 出组态(drop-over-out)无条件压制:出组 =
                                // 已不在任何组内,所有组名蓝框熄灭,反馈转移
                                // 到 ghost 卡蓝框(用户实测:底边离开组名上
                                // 边后组名框必须灭)。
                                // (#system-group-frozen 2026-09-08) 保留组
                                // (本地终端)组名拖拽中恒不亮主题色蓝框:
                                // 不参与进组命中、也不会成为待出组 owner。
                                property <bool> drop-hit: root.list-dragging
                                    && !root.drop-over-out
                                    && !session.builtin
                                    && (parent.gh-overlap
                                        || (root.drop-over-pending
                                            && root.drop-over-pending-owner == session.group));
                                width: 100%;
                                height: 100%;
                                // (#ctx-menu-pin-r2) 菜单打开期间保持组头
                                // hover 高亮(全局 key 比对,组头前缀防撞)。
                                // (#group-hierarchy-weight 2026-09-10) 组头常态
                                // 给一层 panel-alt 底色:层级高的元素靠**底色块**
                                // 变重,而不是靠字号变大。三态递进保证 hover /
                                // 拖拽命中仍可辨识:
                                //   常态 bg-panel-alt → hover bg-hover → 命中 accent
                                // 注意 bg-hover(#373a44) 比 bg-panel-alt(#2a2d35)
                                // 亮一档,故 hover 依然读得出"抬升"。
                                background: drop-hit
                                    ? Theme.accent.with-alpha(0.20)
                                    : ((grp-ta.has-hover
                                        || root.ctx-open-key == "hdr:" + session.group-header)
                                        ? Theme.bg-hover : Theme.bg-panel-alt);
                                animate background { duration: 120ms; }
                                border-width: drop-hit ? 1px : 0px;
                                border-color: Theme.accent;
                                drop-shadow-blur: drop-hit ? 10px
                                    : (root.group-dragging && session.group == root.group-drag-id ? 14px : 0px);
                                drop-shadow-color: drop-hit ? #00000050
                                    : (root.group-dragging && session.group == root.group-drag-id ? #00000060 : transparent);
                            // (#ctx-menu-backdrop 2026-09-08) 右键菜单迁往
                            // AppWindow 根集中浮层,组头仅在上报状态。
                            // 拖动手势状态(本组头局部):按下 y / 是否拖动。
                            property <length> g-press-y: 0px;
                            property <bool> g-was-drag: false;
                            // TouchArea 前置声明:后面的 Text 引用它的 hover 态
                            // (Slint 不允许向前引用 id)。
                            grp-ta := TouchArea {
                                mouse-cursor: root.group-dragging ? move : pointer;
                                // (#tree-line-hover 2026-09-10) 组头是"这组的把
                                // 手":悬停组头同样点亮本组整条脊线,与悬停组
                                // 内任一成员给出一致的归属反馈。撤销条件与成
                                // 员行同构——只有 key 仍指向自己才允许清空,
                                // 避免组头 → 成员交接瞬间被误清(闪一下)。
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hover-key = "hdr:" + session.group;
                                        root.hover-group = session.group;
                                    } else if (root.hover-key == "hdr:" + session.group) {
                                        root.hover-key = "";
                                        root.hover-group = "";
                                    }
                                }
                                // (#drag-group-head-geom) 组头落点上报已移至外壳
                                // 的 gh-hit 几何判定:has-hover 在拖拽中被 grab
                                // 冻结,拖到组头上永远不触发(拖不进组的根因)。
                                // Left-click toggles collapse (any group, incl.
                                // empty); right-click opens the group menu.
                                // 拖动过的 up 不触发折叠(g-was-drag 抑制)。
                                clicked => {
                                    if (!parent.g-was-drag && root.search-query == "") {
                                        root.toggle-group(session.group);
                                    }
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        parent.g-press-y = self.mouse-y;
                                        parent.g-was-drag = false;
                                    } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                                        // (#drag-fly-home-r2 2026-09-10) 归位窗口
                                        // 期内不提交:取消(Esc/右键/切窗)已在
                                        // 处理,此时组头 up 若走 reorder-group 会
                                        // 把"取消"变成"重排"。直接进 else 只清
                                        // g-was-drag(抑制后续 clicked 折叠)。
                                        if (root.group-dragging && session.group == root.group-drag-id
                                                && !root.drag-fly-home) {
                                            // 松手落位:(#group-drag-collapse)
                                            // 行级多位换位——折叠后组头等高一
                                            // 行,每越一行移一位,一次可跨多行;
                                            // Rust 端 clamp 越界。
                                            root.reorder-group(session.group,
                                                Math.clamp(Math.round(root.group-dy / root.drag-pitch), -20, 20));
                                            root.group-dragging = false;
                                            root.group-drag-id = "";
                                            root.group-dy = 0px;
                                            root.group-drag-collapse = "";
                                            // 延迟清 g-was-drag:clicked 在
                                            // pointer-up 之后派发,需保持抑制。
                                            g-reset.restart();
                                        } else {
                                            parent.g-was-drag = false;
                                        }
                                    } else if (!session.builtin && !root.group-dragging
                                        && e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                        // (#ctx-menu-backdrop) 弹层状态直写
                                        // Welcome 级,由 AppWindow 根浮层渲染;
                                        // key 带组头前缀防与成员行 id 撞车。
                                        root.ctx-gen += 1;
                                        root.ctx-open-key = "hdr:" + session.group-header;
                                        root.ctx-menu-kind = "group";
                                        root.ctx-menu-group = session.group;
                                        root.ctx-menu-empty = session.id == "";
                                        root.ctx-menu-x = self.absolute-position.x + self.mouse-x;
                                        root.ctx-menu-y = self.absolute-position.y + self.mouse-y;
                                        // (#ctx-menu-flip) 本组头到面板底的余量,
                                        // 供浮层做"超面板底上翻"。事件期读几何安全。
                                        root.ctx-menu-space-below =
                                            flick.absolute-position.y + flick.height
                                            - (self.absolute-position.y + self.mouse-y);
                                        // (#ctx-menu-autoclose) 触发行(组头壳)矩形。
                                        root.ctx-row-x = self.absolute-position.x;
                                        root.ctx-row-y = self.absolute-position.y;
                                        root.ctx-row-w = self.width;
                                        root.ctx-row-h = self.height;
                                    }
                                }
                                // (#ctx-menu-autoclose) 菜单打开时注册本组头矩形
                                // 与身份(blank 空组头同样注册,kind=group)。
                                // changed 只能监听自身属性,经中转 watch 桥接根状态。
                                property <bool> ctx-open-watch: root.ctx-open-key != "";
                                changed ctx-open-watch => {
                                    if (root.ctx-open-key != "" && !session.builtin) {
                                        root.reg-ctx-row({
                                            x: self.absolute-position.x,
                                            y: self.absolute-position.y,
                                            w: self.width,
                                            h: self.height,
                                            space-below: flick.absolute-position.y + flick.height
                                                - (self.absolute-position.y + self.height),
                                            key: "hdr:" + session.group-header,
                                            kind: "group",
                                            group: session.group,
                                            empty: session.id == "",
                                            gen: root.ctx-gen,
                                        });
                                    }
                                }
                                moved => {
                                    // (#system-group-frozen 2026-09-08) 保留组
                                    // 组头不可拖动排序(reorder_group 只管
                                    // explicit groups,system 拖起也无效,直接禁)。
                                    // (#default-group-locked 2026-09-10) 默认组
                                    // 同样不参与组排序:它恒排在可进入组最顶,
                                    // 且不在 explicit groups 里 —— reorder_group
                                    // 找不到它,拖起只会得到"拖了却没变化"的
                                    // 假反馈,直接禁拖(用户定稿:不参与组排序)。
                                    if (self.pressed && !root.group-dragging
                                            && !session.builtin
                                            && session.group != "default"
                                            && abs(self.mouse-y - parent.g-press-y) > 5px) {
                                        root.group-dragging = true;
                                        root.group-drag-id = session.group;
                                        root.group-dy = 0px;
                                        // (#group-drag-collapse 2026-09-08) 拖起
                                        // 自动折叠:把被拖组收起来,组头之间距离
                                        // 就统一成一行,"拖过几格 = 换几位"才成立
                                        // (成员行同步隐藏);松手/取消后恢复。
                                        root.group-drag-collapse = session.group;
                                        parent.g-was-drag = true;
                                    }
                                    if (root.group-dragging && session.group == root.group-drag-id) {
                                        root.group-dy = self.mouse-y - parent.g-press-y;
                                    }
                                }
                            }
                            // 180ms 后复位 g-was-drag(clicked 已派发完毕)。
                            g-reset := Timer {
                                interval: 180ms;
                                triggered => { parent.g-was-drag = false; }
                            }
                            HorizontalLayout {
                                padding-top: 0;
                                padding-bottom: 0;
                                // (#caret-align-spine 2026-09-10) 三角(chevron)
                                // 与成员脊线**同轴对齐**:脊线 x = 10 + indent/2
                                // - 1 = 18px、宽 2px → 轴心 19px;chevron 字形
                                // 在 fs-xl(18px) 下 advance ≈ 18px,故左内边距
                                // 取 10px 时字形中心 = 10 + 9 = 19px,与脊线轴心
                                // 重合。折叠/展开切换时三角只换字形不改位,轴心
                                // 恒稳定——组头与成员由同一根轴串起来,不再左右
                                // 错半格。原值 4px 会让三角偏左 6px。
                                padding-left: 10px;
                                // (#group-count-badge-r6) 右缘留白:计数徽章不
                                // 再被组头 hover 圆角收腰切割。
                                padding-right: 10px;
                                spacing: 4px;
                                // Collapse chevron — shown for every group, empty
                                // folders included, so they line up and can be
                                // toggled (an empty group just expands to nothing).
                                // (#session-tree-hierarchy-r4) 双字形切换(▸/▾)。
                                Text {
                                    text: session.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                                    font-family: "Material Icons";
                                    // (#group-hue-align-html 2026-09-10) chevron
                                    // 染组色(对齐 HTML 原型:caret = var(--gc))——
                                    // 折叠箭头是组身份的一部分,灰色削弱归属感。
                                    // hover 仍提亮为 text-primary 保留交互反馈。
                                    // (#group-hue-keep 2026-09-10) 悬停**不再**把组
                                    // 色抹成 text-primary:底色 bg-hover 已经承担
                                    // hover 反馈,再把 chevron/文件夹漂白,等于把
                                    // "这是哪个组"的唯一色标抹掉(用户截图:悬浮时
                                    // 组头整行变白)。组身份色恒定,变的只有底色。
                                    color: Theme.group-hue-color(session.group-hue);
                                    font-size: Theme.fs-xl;
                                    vertical-alignment: center;
                                }
                                Text {
                                    // (#folder-open-state 2026-09-05) 文件夹随
                                    // 分组状态切换:闭合 E2C7 / 打开 E2C8,与
                                    // chevron(▸/▾)同向联动。
                                    text: session.collapsed ? "\u{E2C7}" : "\u{E2C8}";
                                    font-family: "Material Icons";
                                    // (#group-hue-align-html 2026-09-10) 文件夹
                                    // 同染组色:与 chevron、脊线、成员行构成同源
                                    // 色彩链,组身份一眼可辨。
                                    // (#group-hue-keep 2026-09-10) 悬停**不再**把组
                                    // 色抹成 text-primary:底色 bg-hover 已经承担
                                    // hover 反馈,再把 chevron/文件夹漂白,等于把
                                    // "这是哪个组"的唯一色标抹掉(用户截图:悬浮时
                                    // 组头整行变白)。组身份色恒定,变的只有底色。
                                    color: Theme.group-hue-color(session.group-hue);
                                    font-size: Theme.fs-xl;
                                    vertical-alignment: center;
                                }
                                Text {
                                    // (#group-name-i18n 2026-09-08) 内置保留组
                                    // "system" 仅在【显示层】翻译(中文=本地终端
                                    // / 英文=Local Terminals);内部标识仍用字符串
                                    // "system"(move-to-group 目标、保留组识别
                                    // welcome.slint:440、测试断言均依赖),不得改
                                    // 字段值,否则右键/拖拽逻辑与数据层错位。
                                    // (#default-group-header 2026-09-10) "default"
                                    // 与 "system" 一样只做**显示层**翻译(默认组 /
                                    // Default group):存储层仍是 "default" 字样,
                                    // 拖拽落点、保留组识别、Rust 断言都依赖它。
                                    text: session.group-header == "system"
                                        ? @tr("Local Terminals")
                                        : (session.group-header == "default"
                                            ? @tr("Default group")
                                            : session.group-header);
                                    // (#group-hue-keep 2026-09-10) 组名同静止:
                                    // 悬停时不再从 text-secondary 提亮成 text-primary。
                                    // 用户反馈"悬浮时组名的颜色被去掉"——组头前景
                                    // 色的任何改写都会被读成"身份色丢了";hover
                                    // 反馈统一交给底色,前景全恒定。
                                    color: Theme.text-secondary;
                                    // (#group-hierarchy-weight 2026-09-10) 组名与
                                    // 成员**同字号**(fs-md)。两级树形列表里组是
                                    // "容器"、成员是"内容",二者是同类标识符,不是
                                    // "标题 vs 正文"——用更大字号会给出错误的层
                                    // 级暗示(原 fs-lg 组名 + 700 反而让组名比成员
                                    // 更"大",与层次意图相反)。层级改由**重量**
                                    // 表达:组头底色块 + 字重 600 + 左侧脊线 +
                                    // 成员缩进,字号保持同级。
                                    font-size: Theme.fs-md;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;       // fill → text stays left
                                    horizontal-alignment: left;
                                }
                                // (#group-count-badge-r4) 徽章与组名垂直对齐:
                                // HorizontalLayout 中固定高度的子项默认顶对
                                // 齐,外包 alignment: center 的 VL 强制居中。
                                // (#group-count-badge-r6 2026-09-05) 切割修复:
                                // 徽章原本贴到组头行右缘,而组头 hover 高亮的
                                // 圆角在右缘"收腰",视觉上把徽章右端切掉一块
                                // (用户反馈)。组头布局补 padding-right: 10px
                                // 让徽章内收;内边距 5→6px 给数字更多余量。
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        // (#badge-preview 2026-09-10) 落点预览:
                                        // 有成员将落入本组时,徽章写成 `3 → 4`
                                        // 并用主题色点亮(对齐交互原型)——
                                        // 松手之前就能确认"这组会多一个"。
                                        property <bool> preview:
                                            root.drop-here-group == session.group;
                                        height: 16px;
                                        width: num.preferred-width + 12px;
                                        border-radius: 8px;
                                        background: self.preview ? Theme.accent-solid
                                            : ((grp-ta.has-hover
                                                || root.ctx-open-key == "hdr:" + session.group-header)
                                                ? Theme.bg-active : Theme.bg-elevated);
                                        animate background { duration: 120ms; }
                                        num := Text {
                                            x: 6px;
                                            height: parent.height;
                                            text: parent.preview
                                                ? "\{session.group-size} → \{session.group-size + 1}"
                                                : "\{session.group-size}";
                                            // 数字用等宽字体:行盒比 CJK UI 字
                                            // 体小得多,宽度也可预测。
                                            font-family: Theme.font-mono;
                                            // (#badge-preview) 预览时徽章是主题色
                                            // 实底,文字随之翻白。
                                            color: parent.preview ? #ffffff : Theme.text-secondary;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                            y: 1px;
                                        }
                                    }
                                }
                            }
                        }
                        }
                        // (#empty-group-hint 2026-09-05) 空分组展开时显示占位,
                        // 消除"点击分组却什么都没发生"的困惑。blank 行(组头
                        // 且 id == "")只在非搜索路径生成(session_models)。
                        if session.group-header != "" && session.id == "" && !session.collapsed : Rectangle {
                            height: 22px;
                            Text {
                                x: 10px + 18px;   // 与成员行缩进对齐
                                y: 0;
                                height: parent.height;
                                text: @tr("Empty");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                            }
                        }
                        // (#group-drag-collapse) 组头拖拽期间,被拖组的成员
                        // 行隐藏(组视觉折叠为一行)——展开大组与折叠组统一
                        // 行级换位手感;松手/取消即恢复。
                        if session.id != "" && !session.collapsed
                            && !(root.group-dragging && session.group == root.group-drag-collapse) : Rectangle {
                            // (#slot-shift 2026-09-07) 让位 wrapper:布局子元素
                            // 不能设 y(VL 拥有位置),由本层承载几何、内部 srow
                            // 用 y 偏移绘制。clip 关掉:位移出界时溢出绘制盖住
                            // 邻行,正是让位效果。缩进沿用原 srow 块。
                            height: root.compact ? 38px : 36px;
                            clip: false;
                            srow := SessionRow {
                                width: parent.width;
                                height: parent.height;
                            session: session;
                            compact: root.compact;
                            // (#session-hover-card) 信息卡片坐标/文本中转到
                            // Welcome,再由实例侧绑到 AppWindow 根浮层。
                            card-out-name <=> root.card-out-name;
                            card-out-host <=> root.card-out-host;
                            card-out-note <=> root.card-out-note;
                            card-out-x <=> root.card-out-x;
                            card-out-y <=> root.card-out-y;
                            // (#tree-line-hover 2026-09-10) 组脊线 hover 状态
                            // 双向转发:本行写、全组读(同组其它行由自己的
                            // 实例读同一个 Welcome 级值)。
                            hover-group <=> root.hover-group;
                            hover-key <=> root.hover-key;
                            // (#ctx-line-keep 2026-09-10) 菜单锚点落在本组 →
                            // 本组每一行的竖线段都保持点亮(脊线按行分段画,
                            // 整条一起亮要靠每行各自判断,见组件内说明)。
                            ctx-group-active: root.ctx-open-key != ""
                                && root.ctx-menu-group == session.group;
                            // (#drag-ghost-pointer) 拖动共享状态下行分发 +
                            // 本行内容坐标 y(与 sess-list 同为 flick 子元素,
                            // viewport 平移相消,得到纯内容坐标)。
                            drag-out-dy <=> root.drag-dy;
                            drag-dy <=> root.drag-dy;
                            drag-id <=> root.drag-id;
                            drag-pitch <=> root.drag-pitch;
                            pointer-y: list-host.drag-pointer-y;
                            drag-origin-y: root.drag-origin-y;
                            drag-group: root.drag-group;
                            // (#shift-drop-same-source) 两态标志下发。
                            drop-over-pending: root.drop-over-pending;
                            drop-over-out: root.drop-over-out;
                            drag-fly-home: root.drag-fly-home;
                            drag-cancel-pending <=> root.drag-cancel-pending;
                            // (#drag-ghost-pointer 2026-09-06) slot-y 改为私有
                            // 存储属性;此处不再绑 absolute-position —— 旧写法让
                            // slot-y 在 init 期读自身几何(布局未定型),被
                            // ghost-over(被 background/if 在 init 拉取)连带求值
                            // → i-slint-core properties.rs "Recursion detected"
                            // panic(本包"无法打开"根因)。改为仅在拖拽中经
                            // changed 钩子写入:list-dragging 转 true 时对【所有
                            // 可见行】广播一次性定位(行在拖拽中不移动,一次足
                            // 矣)。absolute-position 只在几何稳定的拖拽期读取,
                            // 启动期完全不碰,安全。
                            // (#slot-y-deferred-r3 2026-09-07) 回到同步写入:
                            // r1/r2 的 0ms Timer 延迟捕获在 slint 1.8 上从未
                            // 触发(restart + running:false 静态绑定的组合不可
                            // 靠),slot-y 全程 0 → 行命中/让位/组头全灭。同步
                            // 写在回归前一直稳定;"拖回重叠"的真正根因是组
                            // 让位方向恒 +pitch(已修),与捕获时机无关。
                            changed list-dragging => {
                                if (root.list-dragging) {
                                    srow.slot-y =
                                        srow.absolute-position.y - sess-list.absolute-position.y;
                                }
                            }
                            drop-report(id, after, group, position) => {
                                // (#group-head-exit-two-state-r3) 行命中 = 入组
                                // 接管(展开组):清待出组/出组两态与组头态,
                                // ghost 卡样式由 drag-drop-group 切回成员样式。
                                root.drop-over-out = false;
                                root.drop-over-out-owner = "";
                                root.drop-over-pending = false;
                                root.drop-over-pending-owner = "";
                                root.drop-over-group = "";
                                root.drop-over-group-owner = "";
                                root.drop-target-id = id;
                                root.drop-after = after;
                                // (#ghost-pill) 落点组 + 位次快照,供 ghost 右侧
                                // 标签与组头徽章预览共用。
                                root.drop-target-group = group;
                                root.drop-target-pos = position;
                                // (#ghost-band) 落点层级:ghost 卡样式跟随本行。
                                root.drag-drop-owner = id;
                                root.drag-drop-group = group;
                                // (#exit-two-state-r4) 行命中 = 进入成员排序
                                // 模式:压制 pending/out 几何(表达式含此标志),
                                // 直至 drop-leave 离开成员行才退出。
                                root.drag-in-member-mode = true;
                                // (#bottom-ingress) 顶基准命中计数:供仲裁
                                // Timer 判定本周期是否需要采纳底缘候选。
                                root.top-hit-tick += 1;
                            }
                            bottom-report(id, group, position) => {
                                // (#bottom-ingress) 只记录候选,采纳与否由
                                // 16ms 仲裁 Timer 决定(顶基准命中优先)。
                                root.bottom-candidate = id;
                                root.bottom-candidate-group = group;
                                root.bottom-candidate-pos = position;
                            }
                            drop-leave(id) => {
                                // (#ghost-band) 只清"自己写的"归属标记,不清
                                // drag-drop-group:行与行之间有死亡区(下移
                                // 方向 = 被拖行自身槽区间,行命中排除自己),
                                // 清空会让 ghost 卡在"落点仍是上一行 after"
                                // 时提前翻成顶层样式,松手却提交组内 —— 样式
                                // 与提交不一致(用户实测)。残留 group 与落点
                                // 快照同源,样式恒与松手结果一致;drag-start/
                                // drag-end/cancel-drag 统一清。
                                // (#exit-two-state-r3) 例外:离场后无任何行
                                // 命中(组间空隙/行间死亡区)时,落点组回落到
                                // 拖起时的组,pending/out 几何重新有资格成立。
                                // (#exit-two-state-r4) 同时退出成员排序模式:
                                // 该标志织在 pending/out 表达式里,置 false 使
                                // 几何值真翻 → changed 正常触发,组名下缘的
                                // 待出组、组名上方的出组得以重新亮起(否则接管
                                // 清态后几何恒真、changed 永不再触发,出组态
                                // 残留/组名蓝框不灭的根源)。
                                if (root.drag-drop-owner == id) {
                                    root.drag-drop-owner = "";
                                    root.drag-drop-group = root.drag-group;
                                    root.drag-in-member-mode = false;
                                }
                            }
                            // (#default-group-header 2026-09-10) default(默认组)
                            // 现在是**正常分组**:有组头、可折叠,成员同样缩进并
                            // 挂树线。原先给 default 开的"无缩进 / 无树线"特例一
                            // 并退役——那是"未分组成员平铺在顶层"那版的遗留,而
                            // 平铺正是用户要求消灭的"单独会话"。
                            content-indent: 18px;
                            tree-guide: true;
                            all-sessions: root.sessions;
                            // Drag-reorder is meaningless while the list is a
                            // filtered subset, and system rows can't move.
                            // (Whitespace-only queries never reach here: the
                            // search handler normalizes them to "".)
                            reorder-enabled: root.search-query == "" && !session.builtin;
                            list-dragging: root.list-dragging;
                            // (#ctx-menu-pin-r2) 菜单高亮全局 key 双向转发。
                            ctx-open-key <=> root.ctx-open-key;
                            // (#ctx-menu-backdrop) 右击上报:全局 key + 弹层
                            // 数据(kind/组) + 点击点窗口坐标 + 本行到面板底的
                            // 余量(供浮层做"超面板底上翻")。事件回调期几何
                            // 稳定,读 absolute-position 安全(drag-start 先例)。
                            ctx-opening(px, py) => {
                                root.ctx-gen += 1;
                                root.ctx-open-key = session.id;
                                root.ctx-menu-kind = "row";
                                root.ctx-menu-group = session.group;
                                root.ctx-menu-x = srow.absolute-position.x + px;
                                root.ctx-menu-space-below =
                                    flick.absolute-position.y + flick.height
                                    - (srow.absolute-position.y + py);
                                root.ctx-menu-y = srow.absolute-position.y + py;
                                // (#ctx-menu-autoclose) 触发行矩形(窗口坐标),
                                // 安全区探测层据此定位。
                                root.ctx-row-x = srow.absolute-position.x;
                                root.ctx-row-y = srow.absolute-position.y;
                                root.ctx-row-w = srow.width;
                                root.ctx-row-h = srow.height;
                            }
                            // (#ctx-menu-autoclose) 菜单打开时全量注册本行矩形
                            // 与身份(backdrop 右击按坐标命中,一步换菜单)。
                            // absolute-position 在菜单打开的稳定期读取,安全。
                            changed ctx-open-key => {
                                if (root.ctx-open-key != "" && !session.builtin) {
                                    root.reg-ctx-row({
                                        x: srow.absolute-position.x,
                                        y: srow.absolute-position.y,
                                        w: srow.width,
                                        h: srow.height,
                                        space-below: flick.absolute-position.y + flick.height
                                            - (srow.absolute-position.y + srow.height),
                                        key: session.id,
                                        kind: "row",
                                        group: session.group,
                                        empty: false,
                                        gen: root.ctx-gen,
                                    });
                                }
                            }
                            connect => { root.connect-session(session.id); }
                            edit => { root.edit-session(session.id); }
                            duplicate => { root.duplicate-session(session.id); }
                            move-to-group(g) => { root.move-session(session.id, g); }
                            reorder(dir) => { return root.reorder-session(root.drag-id, dir); }
                            drag-start => {
                                // (#drag-fly-home-r2 2026-09-10) 新拖拽从干净归位
                                // 态起:极端时序下上一轮归位未落地时先强制解除,
                                // 避免残留的让位/命中冻结干扰本次拖拽。
                                root.drag-fly-home = false;
                                root.drag-id = session.id;
                                // (#slot-shift-same-group) 记录被拖行组:
                                // 让位仅同组,跨组不画框不让人。
                                root.drag-group = session.group;
                                // (#current-group 2026-09-10) "当前所处组"从拖起
                                // 行所属组起算;之后由组头按前导边落入区间上报覆盖。
                                root.drag-current-group = session.group;
                                // 先清状态再拉起 dragging:若 changed 钩子同步
                                // 触发,也不能读到上一轮残留。
                                root.drop-over-head = false;
                                root.drop-over-ungroup = false;
                                root.drop-over-out = false;
                                root.drop-over-out-owner = "";
                                root.drop-over-pending = false;
                                root.drop-over-pending-owner = "";
                                root.drop-over-group = "";
                                root.drop-over-group-owner = "";
                                root.drag-drop-group = "";
                                root.drag-drop-owner = "";
                                root.drag-in-member-mode = false;
                                root.drag-scroll-dy = 0px;
                                root.drag-dy = 0px;
                                root.list-dragging = true;
                                // (#drag-ghost-pointer) ghost 快照:内容三元组
                                // + 原槽内容坐标 y。原点必须取 sess-list(同为
                                // flick 子元素,viewport 平移相消)——取 flick
                                // 会把滚动偏移计入,列表滚动过 ghost 就错位。
                                root.drop-target-id = "";
                                root.drop-after = false;
                                root.drop-target-group = "";
                                root.drop-target-pos = 1;
                                root.drag-name = session.name;
                                root.drag-host = session.port > 0
                                    ? session.host + ":" + session.port
                                    : session.host;
                                root.drag-conn = session.conn-state;
                                root.drag-builtin = session.builtin;
                                root.drag-origin-y =
                                    srow.absolute-position.y - sess-list.absolute-position.y;
                            }
                            drag-end => {
                                // (#drag-deferred-commit) 只记录状态与参数,
                                // 实际提交由 0ms Timer 下一轮分派——回调栈内
                                // 同步重建模型会销毁正在执行回调的本行。
                                // 快照必须先于 list-dragging=false 读取:
                                // over-head / over-ungroup 都是依赖
                                // list-dragging 的几何绑定,置 false 会同步
                                // 触发 changed 钩子把状态位清空。
                                let oh = root.drop-over-head;
                                let ou = root.drop-over-ungroup;
                                let oo = root.drop-over-out;
                                let op = root.drop-over-pending;
                                let og = root.drop-over-group;
                                let target = root.drop-target-id;
                                let after = root.drop-after;
                                // (#dwell-collapse 2026-09-10) 快照必须在
                                // list-dragging 置 false 之前读(drop-target-group
                                // 等几何绑定随后会被 changed 钩子清空)。
                                // 落点确实落在那个"临时展开的组"里(组头第一
                                // 位 og,或组内某行 drop-target-group)→ 保持
                                // 展开,用户是要拖进去;否则留给 300ms Timer
                                // 收起,恢复拖拽前的折叠状态。
                                if (root.drag-expanded-group != ""
                                        && (og == root.drag-expanded-group
                                            || root.drop-target-group == root.drag-expanded-group)) {
                                    root.drag-expanded-group = "";
                                }
                                root.list-dragging = false;
                                root.drop-over-head = false;
                                root.drop-over-ungroup = false;
                                root.drop-over-out = false;
                                root.drop-over-out-owner = "";
                                // (#current-group 2026-09-10) 松手即清"当前所处组"。
                                root.drag-current-group = "";
                                root.drop-over-pending = false;
                                root.drop-over-pending-owner = "";
                                root.drop-over-group = "";
                                root.drop-over-group-owner = "";
                                root.drag-drop-group = "";
                                root.drag-drop-owner = "";
                                root.drag-in-member-mode = false;
                                root.drop-target-id = "";
                                root.drop-target-group = "";
                                root.drop-target-pos = 1;
                                root.drag-group = "";
                                root.drag-id = "";
                                root.commit-id = session.id;
                                // 先算 op 再赋 target:Slint 会把 let 局部
                                // move 进属性 set,赋值后再引用会 E0382。
                                // 优先级:待出组(回原位,不提交) > 进该组第
                                // 一位(组头接触/折叠组名) > 移出分组(出组态
                                // 或列表底越界) > 移到首位 > 行落点。
                                root.commit-op = op ? ""
                                    : og != "" ? "group"
                                    : (ou || oo) ? "ungroup"
                                    : oh ? "start"
                                    : (target != "" ? "to" : "");
                                root.commit-target = target;
                                root.commit-after = after;
                                root.commit-group = og;
                                root.drag-dy = 0px;
                                root.drag-scroll-dy = 0px;
                            }
                            remove => { root.remove-session(session.id); }
                            }
                        }
                    }
                    }
                    // (#drag-autoscroll 2026-09-07) 拖到列表上下边缘自动滚动
                    // (tabs.slint #408 同款):机器多于一屏时一次拖到位。指针
                    // 的可视 y = 内容 y + viewport-y(viewport-y ≤ 0)。
                    property <length> pointer-visible-y: list-host.drag-pointer-y + flick.viewport-y;
                    // (#autoscroll-tiers 2026-09-09) 速度分级:原单一 7px/帧
                    // 在长列表里"拖到底要等半天",放大步长又会过头。按进入
                    // 边缘区的深度分两档——浅区 7px 精调、深区 14px 快滚。
                    property <length> edge-step:
                        !root.list-dragging ? 0px
                        : (self.pointer-visible-y < 12px ? -14px
                        : (self.pointer-visible-y < 28px ? -7px
                        : (self.pointer-visible-y > flick.height - 12px ? 14px
                        : (self.pointer-visible-y > flick.height - 28px ? 7px : 0px))));
                    Timer {
                        interval: 16ms;
                        running: flick.edge-step != 0px;
                        triggered => {
                            // (#drag-autoscroll-bound 2026-09-07) 只累计【真正
                            // 发生】的滚动量。滚到顶/底后 clamp 返回原值(实际
                            // 位移 0),若仍按 edge-step 每帧累加,drag-scroll-dy
                            // 会一路冲到 ±6000px 上限;回拖时指针的内容坐标要
                            // 先"消耗"这几千像素才会反向——"拖到顶/到底之后就
                            // 拖不回来了"的真凶(用户实测)。改为用新旧
                            // viewport-y 的差值(实际位移)累计。
                            let before = flick.viewport-y;
                            flick.viewport-y = clamp(before - flick.edge-step,
                                min(0px, flick.height - flick.viewport-height), 0px);
                            // 滚了多少,指针的内容坐标就平移多少,否则 ghost 会
                            // 与指针分离(dy 只记录屏幕位移)。
                            root.drag-scroll-dy = clamp(
                                root.drag-scroll-dy + (before - flick.viewport-y),
                                -6000px, 6000px);
                        }
                    }
                    // (#drag-tail-drop-r4 → #drag-ungroup-pop 2026-09-07) 顶部
                    // 越界 = 移到存储首位;底部越界(越过内容底) = 移出分组
                    // (group 清空,平铺到未分组区,ghost 卡同步变形提示)。无
                    // 文字提示带、无两档分区,列表底部就是普通区域。
                    property <bool> over-head: root.list-dragging && root.drag-id != ""
                        && list-host.drag-pointer-y < 0px;
                    // (#drop-ghost-edge 2026-09-07) 底部越界判定同样改用方向化
                    // ghost 前导边:旧实现用裸指针,比 ghost 底滞后一个行高
                    // ——"ghost 已盖过最后一组最后一个成员"时 ou 仍未亮,松手
                    // 按行落点提交成"组内末尾"而非移出分组,必须再往下拖一行
                    // 才 ungroup。改用 ghost 底后:下移方向 ghost 卡整张越过
                    // 内容底即 ungroup,且越往下拖越满足(不限制朝下位置)。
                    property <length> drop-pointer-y:
                        list-host.drag-pointer-y > root.drag-origin-y
                            ? list-host.drag-pointer-y + (root.drag-pitch - 2px)
                            : list-host.drag-pointer-y;
                    property <bool> over-ungroup: root.list-dragging && root.drag-id != ""
                        && self.drop-pointer-y >= sess-list.preferred-height;
                    changed over-head => {
                        // (#drag-tail-drop-r2) 只上报状态位,目标 id 由 Rust 在
                        // move-session-to-start 里按存储顺序精确计算。
                        root.drop-over-head = self.over-head;
                        // (#exit-two-state-r4) 顶部越界 = 退出成员排序模式。
                        if (self.over-head) { root.drag-in-member-mode = false; }
                    }
                    changed over-ungroup => {
                        root.drop-over-ungroup = self.over-ungroup;
                        // (#exit-two-state-r4) 底部越界 = 退出成员排序模式。
                        if (self.over-ungroup) { root.drag-in-member-mode = false; }
                    }

                    // (#drop-slot-line-r5 2026-09-07) 横线整体退役:用户定稿
                    // "去除蓝色主题色线条",让位基准改为拖动成员(ghost 卡)
                    // 自身边界——下移看下边界、上移看上边界,越过成员名称
                    // (行中线)即让位,判定见 SessionRow #slot-shift-line-base。
                    // 落点感知 = 让位动画本身,无额外指示元素。

                    // (#drag-ghost 2026-09-06) tabs #408 同款 ghost:被拖行
                    // 本体在原槽隐形(opacity 0 = 洞,落点由占位框标出),这张
                    // 浮动卡是唯一跟手元素。声明在 sess-list 之后 → 恒在最
                    // 上层(Slint 无运行时 z,叠放靠声明序),卡片本体从此不再
                    // 压住未让位的邻行;位置钳制在列表内容区内,拖不出边界。
                    if root.list-dragging && root.drag-id != "" : ghost-card := Rectangle {
                        property <length> ghost-h: max(1px, root.drag-pitch - 2px);
                        // (#drag-ungroup-pop 2026-09-07) 底部越界变形:ghost 卡
                        // accent 描边提示"松手 = 移出分组"(唯一出组入口)。
                        // (#group-head-exit-two-state-r3) 蓝框亮于出组态
                        // (drop-over-out:底边离开组名上边)与底部越界两种;
                        // 待出组(pending)无框,组别样式由 in-group 排除表达。
                        // (#default-group-ghost-consistent 2026-09-10) 默认组
                        // 拖动与其它组完全同款。原 #ungrouped-keep-out 给
                        // "未分组"开的特判(无所属组 = 恒亮 accent 出组描边)
                        // 随"默认组升格为正式组"一并退役:默认组成员静态显示
                        // 带缩进与树线,拖起时 ghost 却脱缩进变顶层样式、松手
                        // 又缩回去 —— 明显的视觉跳变(用户定稿:与其它组一致)。
                        property <bool> switch-hit:
                            root.drop-over-out || root.drop-over-ungroup;
                        // (#ghost-band 2026-09-07) 层级样式跟随落点:落点行属于
                        // 某个组 = 成员样式(缩进 + 16px 图标 + fs-md);落点在
                        // 空组 / 无组 = 顶层样式(无缩进 + 20px 图标 + fs-lg 700)。
                        // 归属判定复用提交侧的落点行 group,保证"卡长什么
                        // 样"与"松手后落在哪一层"恒一致。
                        // (#default-group-ghost-consistent 2026-09-10) 默认组已
                        // 升格为正式组(成员静态带缩进与树线),不再算"顶层区"
                        // —— 原先对 "default" 的两处排除会让默认组内拖动时
                        // ghost 脱缩进、松手又缩回(视觉跳变),现一并移除。
                        // (#group-head-tri-state-r3 2026-09-08) 兜底链补最后一
                        // 环 drag-group(拖起时自己的组):未命中任何行(拖起瞬
                        // 间/组间空隙)时 ddg 与 group 均为空,旧判定回落成
                        // 顶层样式 —— 组内成员刚拖起就变成"组别样式"(用户实
                        // 测)。优先级:组头接触 > 行落点 > 拖起时自身。
                        // (#group-head-exit-two-state-r2 2026-09-08) 出组只看
                        // 底部越界(over-ungroup);组头两带已退役。
                        // (#group-head-exit-two-state-r3) 待出组/出组均为
                        // "组别样式"(顶层样式):in-group 排除两态。
                        property <bool> in-group: !root.drop-over-out
                            && !root.drop-over-ungroup
                            && !root.drop-over-pending
                            && (root.drop-over-group != ""
                                || root.drag-drop-group != ""
                                || root.drag-group != "");
                        x: 0px;
                        width: sess-list.width;
                        height: ghost-h;
                        // (#drag-fly-home 2026-09-10) 取消时 180ms 飞回拖起
                        // 原槽(拖动中 0ms 跟手不变);落地 Timer 清态、本体
                        // 行已复现,观感 = 卡片归位没入行中。
                        // (#ease-align-spec) 180ms 对齐规格 §5「取消归位」。
                        y: root.drag-fly-home ? root.drag-origin-y : list-host.ghost-y;
                        animate y { duration: root.drag-fly-home ? 180ms : 0ms;
                            easing: cubic-bezier(0.22, 0.61, 0.36, 1); }
                        border-radius: Theme.radius-sm;
                        // (#drag-ghost-opaque-r2 2026-09-07) 半透明 + 描边、
                        // 无投影:用户要求"拖动的组员半透明"——62% 透明度下
                        // 底行轻微透出,漂移感自然;去投影避免脏阴影。移出
                        // 分组/进组(switch-hit)时描边转 accent。
                        background: Theme.bg-elevated.with-alpha(0.62);
                        border-width: 1px;
                        border-color: switch-hit ? Theme.accent : Theme.border-subtle;
                        animate border-color { duration: 140ms; }
                        HorizontalLayout {
                            padding-left: ghost-card.in-group ? 10px + 18px : 10px;
                            padding-right: 10px;
                            animate padding-left { duration: 140ms; easing: ease-out; }
                            spacing: root.compact ? 8px : 12px;
                            Rectangle {
                                width: ghost-card.in-group ? 16px : 20px;
                                height: ghost-card.in-group ? 16px : 20px;
                                animate width, height { duration: 140ms; easing: ease-out; }
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px;
                                background: Theme.bg-hover;
                                Text {
                                    text: root.drag-builtin ? "\u{E30A}" : "\u{E875}";   // terminal / server
                                    font-family: "Material Icons";
                                    color: Theme.text-secondary;
                                    font-size: ghost-card.in-group ? 11px : Theme.fs-xl;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if root.drag-conn == 1 : Rectangle {
                                    x: -4px;
                                    y: (parent.height - self.height) / 2;
                                    width: 6px; height: 6px;
                                    border-radius: 3px;
                                    background: Theme.warning;
                                }
                                if root.drag-conn == 2 : Rectangle {
                                    x: -4px;
                                    y: (parent.height - self.height) / 2;
                                    width: 6px; height: 6px;
                                    border-radius: 3px;
                                    background: Theme.success;
                                }
                            }
                            if root.compact : Text {
                                horizontal-stretch: 1;
                                text: root.drag-name;
                                color: Theme.text-primary;
                                // (#fs-align-design 2026-09-10) ghost 字号与本体
                                // 同步收口 fs-md:ghost 是"被拎起的本体",字号
                                // 与本体不一致会在起手/落位瞬间跳字号。
                                font-size: Theme.fs-md;
                                font-weight: ghost-card.in-group ? 400 : 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if !root.compact : Text {
                                text: root.drag-name;
                                color: Theme.text-primary;
                                font-size: Theme.fs-md;
                                font-weight: ghost-card.in-group ? 400 : 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if !root.compact : Text {
                                text: root.drag-host;
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            // (#ghost-pill 2026-09-10) 落点标签:贴在 ghost 卡
                            // 右端,把"松手会落到哪个组的第几位"说清楚(对齐
                            // 交互原型)。放卡**内**右端而非卡外——卡片就是
                            // sess-list 全宽行,卡外右侧会越过 list-host 的
                            // clip 边界被裁掉。
                            if !root.compact && root.drop-here-group != "" : Rectangle {
                                height: 18px;
                                width: pill-txt.preferred-width + 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 9px;
                                background: Theme.accent-solid;
                                pill-txt := Text {
                                    x: 8px;
                                    y: 1px;
                                    // 中英文都靠 @tr 承载:"→ {组名} · #{位次}"
                                    // 的参数形式让两种语言的语序各自成立。
                                    text: @tr("→ {} · #{}",
                                        root.drop-here-label, root.drop-here-pos);
                                    color: #ffffff;
                                    font-size: Theme.fs-xs;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    }
                    // (#session-scrollbar) 自绘滚动条:右缘 4px overlay,仅
                    // 内容溢出时出现;按下跳转 + 拖动,hover/按住加深。
                    if flick.viewport-height > flick.height : Rectangle {
                        x: parent.width - 6px;
                        y: 2px;
                        width: 4px;
                        height: parent.height - 4px;
                        background: transparent;
                        // 可视比例 = 视口高 / 内容高;拇指高按比例,设 24px 下限。
                        property <float> ratio: flick.viewport-height > 0px
                            ? flick.height / flick.viewport-height : 1.0;
                        property <length> thumb-h: max(24px, self.height * self.ratio);
                        sb-ta := TouchArea {
                            mouse-cursor: ns-resize;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    // 按下即跳:拇指中心对齐按点。
                                    flick.viewport-y = clamp(
                                        -(self.mouse-y - parent.thumb-h / 2)
                                            * (flick.viewport-height / max(1px, parent.height)),
                                        flick.height - flick.viewport-height, 0px);
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    flick.viewport-y = clamp(
                                        -(self.mouse-y - parent.thumb-h / 2)
                                            * (flick.viewport-height / max(1px, parent.height)),
                                        flick.height - flick.viewport-height, 0px);
                                }
                            }
                        }
                        Rectangle {
                            width: parent.width;
                            height: parent.thumb-h;
                            // 顶部位置:内容偏移比例映射到轨道。viewport-y ≤ 0。
                            y: flick.viewport-height > 0px
                                ? (-flick.viewport-y) / flick.viewport-height * parent.height
                                : 0px;
                            border-radius: 2px;
                            background: sb-ta.pressed || sb-ta.has-hover
                                ? Theme.text-secondary : Theme.border-strong;
                            animate background { duration: 120ms; }
                        }
                    }
                }
        }
}
