// Central design tokens for meatshell.
//
// All colour values are reactive: change `dark` and every widget repaints
// automatically via Slint's property-binding system.
//
// Dark palette  — high-contrast charcoal (original meatshell look).
// Light palette — Apple macOS-inspired:
//   • Backgrounds use #f5f5f7 (Apple page gray) instead of pure white to
//     avoid eye-strain.
//   • Primary text is #1d1d1f (Apple near-black) not #000000.
//   • Accent is #0071e3 (Apple blue), consistent across both themes.

export global Theme {
    // Set by Rust on startup (system detection) and on user toggle.
    in-out property <bool> dark: true;

    // --- Immersive wallpaper (set by Rust from the wallpaper module) -------
    // When a wallpaper is active the window paints `wallpaper` behind everything
    // (see app.slint), panels/terminal frost over it, accent + surfaces shift
    // toward the image's colours, and Rust sets `dark` from the image luminance.
    in-out property <image> wallpaper;
    in-out property <bool>  wallpaper-active: false;
    in-out property <color> wp-accent: #4a90e2;   // vivid accent from the image
    in-out property <color> wp-tint:   #808080;   // average colour, tints surfaces
    // Frosted-panel opacity over a wallpaper (0.30–1.00). User-adjustable via the
    // Interface › Wallpaper opacity slider; bg-root / term-bg derive from it so one
    // control scales the whole wallpaper wash. Default 0.85 (15% transparency).
    in-out property <float> panel-alpha: 0.85;
    property <float> tint-amt: 0.10;              // how far surfaces pull to wp-tint

    // Frost a base surface: pull it slightly toward the wallpaper tint and make
    // it translucent so the image shows through. Returns the plain base colour
    // when no wallpaper is active (so the normal opaque theme is unchanged).
    pure function frost(base: color, alpha: float) -> brush {
        return root.wallpaper-active
            ? base.mix(root.wp-tint, 1.0 - root.tint-amt).with-alpha(alpha)
            : base;
    }

    // --- Palette -----------------------------------------------------------
    // Opaque window base — the wallpaper Image covers it when active, so panels
    // frost over the image rather than over this.
    out property <brush> window-base: dark ? #1b1d23 : #f5f5f7;

    property <color> base-bg-root:      dark ? #1b1d23 : #f5f5f7;
    property <color> base-bg-panel:     dark ? #23262d : #ffffff;
    property <color> base-bg-panel-alt: dark ? #2a2d35 : #f2f2f7;
    property <color> base-bg-elevated:  dark ? #30333c : #e8e8ed;
    property <color> base-bg-hover:     dark ? #373a44 : #e0e0e6;
    property <color> base-bg-active:    dark ? #3f4350 : #d8d8de;

    // bg-root frosts lighter (lower alpha) so the wallpaper reads clearly in
    // empty / inset areas; panels stay mostly opaque for legible text.
    out property <brush> bg-root:      frost(base-bg-root, max(0.0, root.panel-alpha - 0.44));
    out property <brush> bg-panel:     frost(base-bg-panel, root.panel-alpha);
    out property <brush> bg-panel-alt: frost(base-bg-panel-alt, root.panel-alpha);
    out property <brush> bg-elevated:  frost(base-bg-elevated, root.panel-alpha);
    out property <brush> bg-hover:     frost(base-bg-hover, min(1.0, root.panel-alpha + 0.04));
    out property <brush> bg-active:    frost(base-bg-active, min(1.0, root.panel-alpha + 0.08));
    // Settings dialog: 20% less transparent than the other panels so its dense
    // grey labels stay legible even at a low wallpaper overlay (user request).
    out property <brush> bg-panel-strong: frost(base-bg-panel, min(1.0, root.panel-alpha + 0.20));
    // Menus, editors and modal cards must stay readable independently of the
    // wallpaper transparency selected for ordinary application panels (#287).
    out property <brush> popup-bg: base-bg-panel;
    out property <brush> popup-bg-alt: base-bg-panel-alt;

    // (#tab-flush 2026-09-14) 选中标签底色 = 内容区底色(term-bg)，与终端完全同源。
    // 标签下沿方角贴住终端区顶边后，只有底色也一致才真正"连成一片"；早先这里独立
    // 取 #171a20(比终端 #0e0f13 浅一档)/ 亮色 #ffffff(比终端 #fafafa 更白)，贴合处
    // 会留一条色带，等于白贴。壁纸模式下 term-bg 自身霜化，直接引用即自动跟随。
    out property <brush> tab-active-bg: root.term-bg;
    out property <brush> tab-active-border: root.wallpaper-active
        ? root.wp-accent.with-alpha(0.72)
        : (dark ? #06070a : #c7c7cc);
    // (#tab-bar-bg 2026-09-14) 标签栏底色。**独立于 base-bg-panel-alt**：亮色下
    // 后者(#f2f2f7)与白色选中标签只有 1.05:1，而选中态已去掉 2px accent 外框、
    // 改为靠"背景分野"辨识，所以浅色档单独加深到 #eaeaef。不动全局 token，
    // 其它使用 bg-panel-alt 的面板不受影响。
    out property <brush> tab-bar-bg: dark ? #2a2d35 : #eaeaef;

    out property <brush> border-subtle: dark ? #3a3d46 : #e2e2e8;
    out property <brush> border-strong: dark ? #4a4e59 : #c7c7cc;
    // (#hifi-v17 2026-09-18) 控件常态边框:高保真 .control 的 --line,比
    // border-subtle 亮半档、比 border-strong 淡一档 —— 输入框"看得见但不
    // 抢眼"。新建会话对话框用;终端等既有界面仍用上面两档。
    out property <brush> border-control: dark ? #31353e : #dcdce3;
    // (#hifi-v17) 新建会话对话框专用面/线:原型 --field / --field-2 / --line-2 /
    // --panel-hi。独立于 bg-elevated,避免把终端面板一起改暗。
    out property <brush> field: dark ? #191b21 : #f4f5f8;
    out property <brush> field-2: dark ? #1d2027 : #eef0f4;
    out property <brush> line-2: dark ? #3f444f : #c7c7cc;
    // (#dialog-border-lm 2026-09-20) 亮色 #f6f7f9 与弹窗白底几乎无区分,页脚
    // "消失"(实测);加深到 #eef0f4(= field-2 亮色值)。panel-hi 为会话弹窗专用。
    out property <brush> panel-hi: dark ? #282b34 : #eef0f4;

    out property <brush> text-primary:   dark ? #e6e8ee : #1d1d1f;
    // Light-mode secondary/muted darkened further (was #55555a / #7c7c82): over a
    // see-through frosted-wallpaper panel the greys were still too faint to read.
    out property <brush> text-secondary: dark ? #b4b9c4 : #45454a;
    out property <brush> text-muted:     dark ? #9196a3 : #606066;

    // (#default-group-accent 2026-09-10) 强调色的 color 单一来源:brush 不能
    // 当 color 用(组色函数返回 color、且调用处要 .with-alpha()),故先定义
    // color 版,accent(brush)再基于它——避免两处各写一份取值。
    out property <color> accent-solid:   root.wallpaper-active ? root.wp-accent          : (dark ? #4a90e2 : #0071e3);
    out property <brush> accent:         root.accent-solid;
    out property <brush> accent-hover:   root.wallpaper-active ? root.wp-accent.brighter(0.12) : (dark ? #5aa0f2 : #0077ed);
    out property <brush> accent-pressed: root.wallpaper-active ? root.wp-accent.darker(0.12)   : (dark ? #3a80d2 : #006adb);

    // (#close-behavior) 关闭键语义红:世界通用的「关闭」红,与通用
    // danger(#e25c5c,偏柔和的告警色)刻意分开 —— 关闭键要一眼可辨。
    // UI/app.slint 的 WinBtn 与确认卡的「完全退出」卡片共用这两档。
    out property <color> close-red:         dark ? #e81123 : #c42b1c;
    out property <color> close-red-pressed: dark ? #c50f1f : #a52216;

    // (#v4-session-dialog) 选择器选中态 / 开关淡染 / 弹窗遮罩。chip 与 accent-soft
    // 跟强调色走，避免实心 accent 和「创建」主按钮抢层级。modal-scrim 是方案 A：
    // 低 alpha 纯色，无 blur（Slint 无元素级 backdrop-filter）。全屏弹窗要
    // 看得出遮罩，alpha 略高于原型舞台值（暗 0.32 / 亮 0.36）。
    out property <brush> chip:        root.accent-solid.with-alpha(root.dark ? 0.22 : 0.14);
    out property <brush> accent-soft: root.accent-solid.with-alpha(root.dark ? 0.16 : 0.12);
    out property <brush> modal-scrim: root.dark ? #0c0d11.with-alpha(0.32) : #f4f5f8.with-alpha(0.36);
    // 滚动渐隐用的不透明面板色（不能走 frost 后的 brush，否则渐变混成灰）。
    out property <color> panel-solid: root.base-bg-panel;

    out property <brush> success: dark ? #4ec9b0 : #34c759;
    out property <brush> warning: dark ? #e2a84a : #ff9f0a;
    out property <brush> danger:  dark ? #e25c5c : #ff3b30;

    // Terminal uses its own background so it stays readable regardless of
    // what the shell / remote app outputs via ANSI colour codes. With a
    // wallpaper it frosts (kept neutral, not tinted) so text stays legible.
    property <color> base-term-bg: dark ? #0e0f13 : #fafafa;
    out property <brush> term-bg: root.wallpaper-active ? base-term-bg.with-alpha(max(0.0, root.panel-alpha - 0.14)) : base-term-bg;
    out property <brush> term-fg: dark ? #d4d4d4 : #2d2d2f;

    // True on macOS (set by Rust). App shortcuts use Cmd (⌘) here instead of
    // Ctrl, so the physical Ctrl key stays free for the shell (^C/^X…) (#158).
    in-out property <bool> is-mac: false;

    // Whether the app window is focused & visible. Rust drives this from winit
    // focus/minimize/occlusion events; the terminal cursor stops blinking when
    // it's false, so an idle background window doesn't repaint (#127).
    in-out property <bool> window-focused: true;

    // Global UI scale (#100/#117/#118). Rust sets this from the saved setting;
    // all font sizes and spacing/radii below multiply by it, so the whole UI
    // grows/shrinks live (the terminal font has its own size setting).
    in-out property <float> ui-scale: 1.0;
    // Settings-panel font scale (#v0.5). The settings card + its text multiply by
    // this so the panel (which is exempt from ui-scale) can still be enlarged.
    in-out property <float> panel-font: 1.0;

    // --- Typography --------------------------------------------------------
    out property <length> fs-xs: 11px * root.ui-scale;
    out property <length> fs-sm: 12px * root.ui-scale;
    out property <length> fs-md: 13px * root.ui-scale;
    out property <length> fs-lg: 15px * root.ui-scale;
    out property <length> fs-xl: 18px * root.ui-scale;

    // Embedded glyph-complete monospace (Cascadia Mono under a unique name, #114).
    out property <string> font-mono: "Meatshell Mono";

    // UI (sans) font for editable inputs. The embedded mono font has no CJK
    // glyphs and native TextInput doesn't glyph-fallback like Text does, so
    // typing Chinese into a bare TextInput renders tofu. Rust sets this to a
    // CJK-capable system font on startup (empty = platform default).
    in-out property <string> ui-font-family: "";

    // Terminal font — user-configurable via Interface settings, set by Rust
    // from the config on startup. cell size in terminal_view derives from these.
    in-out property <string> term-font-family: "Meatshell Mono";
    in-out property <length> term-font-size: 13px;
    in-out property <bool> term-font-bold: false;

    // --- Protocol glyph (#proto-icon 2026-09-17) ---------------------------
    // 连接协议 → Material Icons 字形。**唯一的协议图标来源**:新建会话对话框
    // 的协议下拉框与左侧会话列表的成员图标都调它,两处恒一致(用户定稿
    // "下拉框里的图标和成员行左侧的图标保持一致")。
    //
    // (#proto-icon-r19 2026-09-17) 码位**按高保真原型 SVG 的造型逐个对齐**,
    // 不按协议语义猜。原型 new-session-dialog-alt-dropdown-2026-09-17.html:
    //   ssh=窗口+提示符  serial=三针接头      telnet=窗口+标题栏  rdp/vnc=显示器+底座
    // 对应内嵌 MaterialIcons-Regular.ttf:
    //   terminal / settings_input_component / web_asset / desktop_windows(均已用字体 cmap 校验存在)。
    // 上一轮挑了 router(serial)/memory(telnet)/computer(ssh),造型与原型不符 —— 用户实测反馈。
    // ssh / local / 未知协议统一回落 terminal。
    //
    // 显式 `public`:被 session_dialog.slint 与 welcome.slint 跨文件调用。
    public pure function protocol-glyph(id: string) -> string {
        if (id == "serial") { return "\u{E8C0}"; }             // settings_input_component 三针接头
        if (id == "telnet") { return "\u{E069}"; }             // web_asset    窗口+标题栏
        if (id == "rdp" || id == "vnc") { return "\u{E30C}"; } // desktop_windows 显示器+底座
        return "\u{EB8E}";                                     // terminal     窗口+提示符
    }

    // (#proto-optical 2026-09-20) 光学尺寸补偿:同一 font-size 下各字形的视觉占位
    // 差异可达 25%(实测 glyf bbox,24 网格高度):
    //   terminal / web_asset 16.03 · desktop_windows 19.97 · settings_input_component 22.03
    // 系数 = 18 / 该字形视觉高,让五个协议在下拉框里视觉等大。
    // 换码位时必须同步更新本表。
    public pure function protocol-scale(id: string) -> float {
        if (id == "serial") { return 0.82; }              // settings_input_component 22.03
        if (id == "rdp" || id == "vnc") { return 0.90; }  // desktop_windows 19.97
        if (id == "telnet") { return 1.12; }              // web_asset 16.03
        return 1.12;                                      // terminal(ssh / local / 未知) 16.03
    }

    // --- Group colour (#group-color 2026-09-14) ----------------------------
    // 分组颜色由**用户在右键菜单里设定**(Rust 侧存 HashMap<组名, hex>,
    // 见 config::set_group_color / group_colors),主题层不再派生任何颜色。
    //
    // 旧的"组名 hash → 8 色调色板"派生机制整体退役:颜色随机、且**改个组名
    // 就换色**,无法承担"身份标识"的职责。用户定稿:"默认就是没有色彩的"。
    //
    // 无色(has-color == false)= 回落该主题的**次级前景色**(text-secondary,
    // 与组头文字同一档),**不是更暗的置灰** —— 此前回落 border-subtle
    // (#3a3d46)时,暗底上 caret / 文件夹图标几乎隐形(用户实测"不要置灰,
    // 无色就好")。
    //
    // 显式 `public`:被 welcome.slint 跨组件调用(Slint 1.8 起对私有跨组件
    // 调用会告警,下一版升为 error)。
    public pure function group-color(has-color: bool, value: color) -> color {
        return has-color ? value : root.text-secondary;
    }

    // (#group-color 2026-09-14) 取色面板的 24 色候选:色环上均匀取 18 档 +
    // 6 档中性灰。明暗主题各一套 —— 暗底取亮档、浅底取深档,保证 1px 树线
    // 与组头图标在各自背景上都清晰可辨。面板按索引取色,两套长度必须一致。
    out property <[color]> group-color-dark: [
        #f87171, #fb923c, #fbbf24, #facc15, #a3e635, #4ade80,
        #34d399, #2dd4bf, #22d3ee, #38bdf8, #60a5fa, #818cf8,
        #a78bfa, #c084fc, #e879f9, #f472b6, #fb7185, #fda4af,
        #f1f5f9, #e2e8f0, #cbd5e1, #a8a29e, #94a3b8, #64748b,
    ];
    out property <[color]> group-color-light: [
        #dc2626, #ea580c, #d97706, #ca8a04, #65a30d, #16a34a,
        #059669, #0d9488, #0891b2, #0284c7, #2563eb, #4f46e5,
        #7c3aed, #9333ea, #c026d3, #db2777, #e11d48, #f43f5e,
        #475569, #334155, #1e293b, #57534e, #78716c, #a8a29e,
    ];

    // --- Geometry ----------------------------------------------------------
    out property <length> radius-sm: 4px * root.ui-scale;
    out property <length> radius-md: 6px * root.ui-scale;
    out property <length> radius-lg: 10px * root.ui-scale;
    out property <length> radius-xl: 16px * root.ui-scale;

    out property <length> gap-xs: 4px * root.ui-scale;
    out property <length> gap-sm: 8px * root.ui-scale;
    out property <length> gap-md: 12px * root.ui-scale;
    out property <length> gap-lg: 16px * root.ui-scale;
}
