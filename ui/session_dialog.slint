                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        // (#hifi-adv-chevron 2026-09-19) transform-rotation
