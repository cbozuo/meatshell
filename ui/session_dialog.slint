}

                    Rectangle { height: 1phx; background: Theme.dark ? Theme.line-2 : #b9b9c2; }

                    if !root.is-real : VerticalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 10px;
                            sf8 := LabeledInput {
                                focus-changed(f) => { if (f) { root.drop-clock += 1; } }
                                dialog-field: true;
                                input-height: 38px;
                                label: @tr("Username");
                                placeholder: root.draft-kind == "rdp" ? @tr("Administrator") : @tr("Prompted on connect if blank");
                                value <=> root.draft-user;
                                clearable: true;
                                canceled => { root.cancel(); }
                                accepted => { root.try-submit(); }
