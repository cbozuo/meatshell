                                        height: 22px;
                                        y: 1px;
                                        border-radius: 7px;
                                        background: Theme.accent-soft;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: root.proto-label(root.draft-kind);
                                                color: Theme.accent;
                                                font-size: Theme.fs-xs;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: root.is-preview
                                                ? @tr("{0} connection · layout preview", root.proto-label(root.draft-kind))
                                                : @tr("{0} connection · layout reserved", root.proto-label(root.draft-kind));
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-sm;
                                            font-weight: 500;
                                        }
                                        Text {
                                            text: root.draft-kind == "vnc"
                                                ? @tr("Dedicated options (color depth, read-only / shared, clipboard) TBD; placeholders below.")
                                                : @tr("Dedicated options (resolution, clipboard / drive redirection, gateway) TBD; placeholders below.");
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-xs;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if !root.is-real : Rectangle { height: 1phx; background: Theme.dark ? Theme.line-2 : #b9b9c2; }
                    if !root.is-real : HorizontalLayout {
    spacing: 12px;
    ProtoSelect {
        opening => { dialog-focus.focus(); }
        drop-clock <=> root.drop-clock;
        label: @tr("Connection protocol");
        value: root.draft-kind;
        previewing: root.is-preview;
        horizontal-stretch: 1.25;
        min-width: 0;
        picked(id) => {
            if (id == "rdp" || id == "vnc") { root.start-preview(id); } else { root.set-kind(id); }
        }
    }
    sf6 := LabeledInput {
        focus-changed(f) => { if (f) { root.drop-clock += 1; } }
        dialog-field: true;
        input-height: 38px;
        label: @tr("Host / IP");
