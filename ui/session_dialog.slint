                        if root.show-advanced : VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 18px; height: 18px; y: 1px;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: root.draft-vt100-drawing ? Theme.accent : Theme.line-2;
                                    background: root.draft-vt100-drawing ? Theme.accent : transparent;
                                    Text {
                                        text: root.draft-vt100-drawing ? "\u{E5CA}" : "";
                                        font-family: "Material Icons"; color: white; font-size: 14px;
                                        width: 100%; height: 100%;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.draft-vt100-drawing = !root.draft-vt100-drawing; }
                                    }
                                }
                                Text {
                                    text: @tr("Enable VT100 line drawing even in UTF-8 mode");
                                    color: Theme.text-primary; font-size: Theme.fs-sm;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                            Text {
                                text: @tr("Show box-drawing output from servers that switch charsets (ESC(0, SO/SI) while staying in UTF-8, e.g. top or mc frames.");
                                color: Theme.text-muted; font-size: Theme.fs-xs; wrap: word-wrap;
                            }
                        }

                        if root.show-advanced && root.draft-kind != "serial" : VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Proxy (optional)"); color: Theme.text-secondary; font-size: Theme.fs-sm; }
                            // (#hifi-v17) 同 .seg 单一外框。
                            Rectangle {
                                height: 36px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border-control;
                                background: Theme.field;
                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 2px;
                                    SegOption { label: @tr("None"); active: root.draft-proxy-type == "none"; clicked => { root.draft-proxy-type = "none"; } }
                                    SegOption { label: "SOCKS5"; active: root.draft-proxy-type == "socks5"; clicked => { root.draft-proxy-type = "socks5"; } }
                                    SegOption { label: "HTTP"; active: root.draft-proxy-type == "http"; clicked => { root.draft-proxy-type = "http"; } }
                                }
                            }
                            if root.draft-proxy-type != "none" : sf14 := LabeledInput {
                                focus-changed(f) => { if (f) { root.drop-clock += 1; } }
                                dialog-field: true;
                                input-height: 38px;
                                label: @tr("Proxy address");
                                placeholder: "127.0.0.1:1080";
                                value <=> root.draft-proxy-hostport;
                                clearable: true;
                                canceled => { root.cancel(); }
                                accepted => { root.try-submit(); }
                            }
                            Text {
                                text: root.draft-proxy-type == "none"
                                    ? @tr("No proxy — use $ALL_PROXY or connect directly")
                                    : @tr("Format: host:port  (with auth: user:pass@host:port)");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                            }
                        }

                        if root.show-advanced && root.draft-kind == "ssh" : VerticalLayout {
                            spacing: 4px;
                            JumpCombo {
                                opening => { dialog-focus.focus(); }
                                drop-clock <=> root.drop-clock;
                                label: @tr("Jump host (optional)");
                                choices: root.jump-choices;
                                selected-index <=> root.draft-jump-index;
                            }
                            Text {
                                text: @tr("Tunnel this connection through another saved SSH session.");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                            }
                        }

                        if root.show-advanced && root.draft-kind == "ssh" : VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 18px; height: 18px; y: 1px;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: root.draft-disable-shell-integration ? Theme.accent : Theme.line-2;
                                    background: root.draft-disable-shell-integration ? Theme.accent : transparent;
                                    Text {
                                        text: root.draft-disable-shell-integration ? "\u{E5CA}" : "";
                                        font-family: "Material Icons"; color: white; font-size: 14px;
                                        width: 100%; height: 100%;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.draft-disable-shell-integration = !root.draft-disable-shell-integration; }
                                    }
                                }
                                Text {
                                    text: @tr("Disable shell integration (Windows / pwsh server)");
                                    color: Theme.text-primary; font-size: Theme.fs-sm;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                            Text {
                                text: @tr("Turn on for Windows servers: skips the cwd-follow hook and monitor that assume a POSIX shell and otherwise break the shell.");
                                color: Theme.text-muted; font-size: Theme.fs-xs; wrap: word-wrap;
                            }

                            HorizontalLayout {
                                Text {
                                    text: @tr("Port forwarding");
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                // (#dialog-no-jump 2026-09-20) 「+添加」常驻:条件渲染时行高 26↔20 变化、
                                // 标题垂直居中偏移,即标题跳动(实测)。功能与下方常驻
                                // 添加框一致,已有行时也可继续追加。
                                Rectangle {
                                    height: 26px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: transparent;
                                    background: add-fw-ta.has-hover ? Theme.accent-soft : transparent;
                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        spacing: 5px;
                                        Text {
                                            text: "\u{E145}";
                                            font-family: "Material Icons";
                                            color: add-fw-ta.has-hover ? Theme.accent : Theme.text-muted;
                                            font-size: Theme.fs-sm;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("Add");
                                            color: add-fw-ta.has-hover ? Theme.accent : Theme.text-muted;
                                            font-size: Theme.fs-sm;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-fw-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.add-forward(); }
                                    }
                                }
                            }
                            // (#dialog-no-jump 2026-09-20) 添加框**常驻**:已有行时点击继续追加,
                            // 标题下方结构恒定,添加/删除不再引起标题跳动(实测)。
                            EmptyAddButton {
                                label: @tr("Add a port forward");
                                clicked => { root.add-forward(); }
                            }
                            if root.forwards.length == 0 : Rectangle {
                                hint-fw-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.add-sample-forward(); }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    // (#hifi-hint-link 2026-09-20) 全部子项 stretch 0 +
                                    // 尾部 filler:说明与代码紧靠左排,中间不留大空隙。
                                    Text {
                                        horizontal-stretch: 0;
                                        text: @tr("Used to reach internal services. Example:");
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-xs;
                                        vertical-alignment: center;
                                    }
                                    // 代码示例 = 主题色,悬浮整段时出现**等宽**下划线;
                                    // 点击(外层)新建端口转发。
                                    VerticalLayout {
                                        horizontal-stretch: 0;
                                        spacing: 1px;
                                        fw-code := Text {
                                            text: "-L 8080 → db.internal:5432";
                                            color: Theme.accent;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: fw-code.preferred-width;
                                            height: 1px;
                                            visible: hint-fw-ta.has-hover;
                                            background: Theme.accent;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            for f[i] in root.forwards : PortForwardRow {
                                forward: f;
                                index: i;
                                updated(index, value) => { root.update-forward(index, value); }
                                remove(index) => { root.delete-forward(index); }
                            }
                            if root.forwards.length > 0 : Text {
                                text: @tr("-L: local port → target reached from the server; -R: server port → target reached from here; -D: local SOCKS5 proxy");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                            }

                            HorizontalLayout {
                                Text {
                                    text: @tr("Login triggers");
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                // (#dialog-no-jump) 同端口转发:常驻防标题跳动。
                                Rectangle {
                                    height: 26px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: transparent;
                                    background: add-trg-ta.has-hover ? Theme.accent-soft : transparent;
                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        spacing: 5px;
                                        Text {
                                            text: "\u{E145}";
                                            font-family: "Material Icons";
                                            color: add-trg-ta.has-hover ? Theme.accent : Theme.text-muted;
                                            font-size: Theme.fs-sm;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("Add");
                                            color: add-trg-ta.has-hover ? Theme.accent : Theme.text-muted;
                                            font-size: Theme.fs-sm;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-trg-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.add-trigger(); }
                                    }
                                }
                            }
                            // (#dialog-no-jump) 同端口转发:添加框常驻。
                            EmptyAddButton {
                                label: @tr("Add a trigger");
                                clicked => { root.add-trigger(); }
                            }
                            if root.triggers.length == 0 : Rectangle {
                                hint-tr-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.add-sample-trigger(); }
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    // (#hifi-hint-link 2026-09-20) 同端口转发段:
                                    // stretch 0 + 尾部 filler 左对齐,下划线等宽。
                                    Text {
                                        horizontal-stretch: 0;
                                        text: @tr("Auto-reply when matching text appears. Example:");
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-xs;
                                        vertical-alignment: center;
                                    }
                                    // 代码示例(「password:」→ 自动发送保存的密码)
                                    // 整体为主题色链接:悬浮下划线,点击(外层)添加触发器。
                                    VerticalLayout {
                                        horizontal-stretch: 0;
                                        spacing: 1px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            tr-code1 := Text {
                                                text: "「password:」";
                                                color: Theme.accent;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.fs-xs;
                                                vertical-alignment: center;
                                            }
                                            tr-code2 := Text {
                                                text: "→";
                                                color: Theme.accent;
                                                font-size: Theme.fs-xs;
                                                vertical-alignment: center;
                                            }
                                            tr-code3 := Text {
                                                text: @tr("automatically send the saved password");
                                                color: Theme.accent;
                                                font-size: Theme.fs-xs;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle {
                                            width: tr-code1.preferred-width + 4px + tr-code2.preferred-width + 4px + tr-code3.preferred-width;
                                            height: 1px;
                                            visible: hint-tr-ta.has-hover;
                                            background: Theme.accent;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            for trigger[i] in root.triggers : TriggerRow {
                                trigger: trigger;
                                index: i;
                                updated(index, value) => { root.update-trigger(index, value); }
                                remove(index) => { root.delete-trigger(index); }
                            }
                            if root.triggers.length > 0 : Text {
                                text: @tr("When expected text appears, send the response automatically. Responses are stored encrypted.");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                wrap: word-wrap;
                            }
                        }
                    }

                }
                }   // (#dialog-focus-reset) viewport 容器 Rectangle 闭合
            }

            // (#fade-inset 2026-09-20) 渐隐条内缩到 body 内容区(20px = body 的
            // padding-left/right):这两条填的是与卡片 popup-bg **同色**的不透明
            // panel-solid,只内缩 1phx 时名义上与 border 内沿相切,但卡片 x 是居中
            // 小数、height 又被 0.78 封顶,1phx 圆角描边落在非整数物理像素相位上会
            // 被抗锯齿摊到相邻两像素,同色填充正好把摊出去的那半份墨擦掉 —— 即
            // "SSH 展开高级后左下角边线断一段"(只在可滚动时 visible,故只在展开后
            // 出现;刚打开 viewport-y==0,顶部那条隐藏,故只见靠下那段)。
            // 内缩 20px 后离 border 足够远;边缘那 20px 本就没有内容可遮,且两色
            // 相同,视觉无差别。
            Rectangle {
                // (#head-line-over-fade) 再让出 1 个物理像素:即便 z 已把头部线抬到
                // 上层,错开相位能让缩放取整时二者彻底不争同一条设备像素行。
                // body 的 padding-top 是 16px,这 1px 内没有内容,且两色相同,看不出。
                y: 1phx;
                x: 20px;
                width: parent.width - 40px;
                height: 18px;
                visible: body-flick.viewport-y > 0px;
                background: @linear-gradient(180deg, Theme.panel-solid 0%, Theme.panel-solid.with-alpha(0.0) 100%);
            }
            Rectangle {
                y: parent.height - 18px;
                x: 20px;
                width: parent.width - 40px;
                height: 18px;
                visible: body-flick.viewport-y < body.preferred-height - body-flick.height;
                background: @linear-gradient(0deg, Theme.panel-solid 0%, Theme.panel-solid.with-alpha(0.0) 100%);
            }
            // (#head-line-moved 2026-09-20) 头部下分隔线。
            //
            // 位置很关键:它必须在**这一层**(body 容器内)、且排在 Flickable 与两条
            // 渐隐条**之后** —— 与页脚那条线恒可见是同一个道理。页脚的线是 foot
            // 自己的 border 顶边,foot 排在 body 之后绘制,所以谁也盖不住它。
            //
            // 之前它作为 close-body 的独立子元素、排在 body 容器**之前**,被容器里的
            // 顶部渐隐条(不透明 panel-solid、与卡片底色同源,仅滚动后 visible)擦掉
            // 墨量;上一轮给它加 z:1 **并没有解决**(用户复测仍消失)—— 布局子元素的
            // z 在这里不可靠。改到本层之后,它就是最后绘制的元素,恒在最上。
            //
            // 高度仍用 1phx(物理像素):逻辑 1px 在 125% 缩放下跨两行光栅化,粗细
            // 会随主题/缩放/展开态浮动(见 #hairline-phx)。
            Rectangle {
                y: 0px;
                width: 100%;
                height: 1phx;
                background: Theme.dark ? Theme.line-2 : #b9b9c2;
            }
        }

        // (#foot-border3 2026-09-20) 布局里这条页脚顶分隔线已删:页脚顶线改由
        // foot 自身的 border 顶边承担(见下),避免两条相邻 1px 叠成 2px。

        foot := Rectangle {
            width: 100%;
            // (#dialog-fit 2026-09-18) 显式高度 = 12 + 38 + 12(高保真 .dlg-foot 的
            // padding 与按钮高)。必须写死:dlg-card 的高度要用 foot.height 推算,
            // 若由布局算出来会构成 dlg-card.height -> layout-cache -> foot.height 的循环。
            height: 62px;
            // (#foot-border3 2026-09-20) 页脚四边框由 foot **自身 border** 画:
            //   · 顶边 = 页脚顶分隔线(与外框同色同宽,布局线已删,不再双线);
            //   · 左/右/下与卡片 border 完全同几何、同色、重叠 —— 贴合无缝,
            //     圆角弧线由两边同几何圆弧重叠承担(上一轮"内缩 1px 露缝"的
            //     方案在亮色主题下缝可见,用户标注①②;叠画补线段则发粗,③);
            //   · border 画在背景之上,panel-hi 底铺满也不遮线。
            background: Theme.panel-hi;
            // (#hairline-phx 2026-09-20) 同外框:1phx 物理像素,含顶线与两个底圆角。
            border-width: 1phx;
            border-color: Theme.dark ? Theme.line-2 : #b9b9c2;
            border-top-left-radius: 0px;
            border-top-right-radius: 0px;
            border-bottom-left-radius: Theme.radius-xl;
            border-bottom-right-radius: Theme.radius-xl;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;
                // (#foot-btn3 2026-09-20) 左右分组:左组吃掉全部剩余空间(测试
                // 连接靠左、状态信息居中),右组 stretch 0 只占内容宽 → 取消/
                // 创建**贴右边框**(高保真 .dlg-foot:测试靠左、取消/创建靠右)。
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                GhostButton {
                    btn-height: 38px;
                    btn-radius: 9px;
                    dialog-chrome: true;
                    // (#hifi-test-icon 2026-09-19) wifi_tethering:波纹扩散,
                    // 呼应"测试连通性"。
                    glyph: "\u{EF48}";
                    // (#foot-btn 2026-09-20) 内容宽,不再均分拉伸。
                    horizontal-stretch: 0;
                    btn-min-width: 0px;
                    hug-width: true;
                    text: @tr("Test connection");
                    clicked => { root.try-test(); }
                }
                    status-box := Rectangle {
                        height: 38px;
                        horizontal-stretch: 1;
                        status-ta := TouchArea {
                            enabled: root.host-missing || root.serial-missing;
                            mouse-cursor: (root.host-missing || root.serial-missing) ? pointer : default;
                            clicked => { root.focus-error-field(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            status-row := HorizontalLayout {
                                // (#foot-status-row 2026-09-20) 显式左对齐 + 明确谁吸空间。
                                // 之前图标 Text 既没写 stretch 也没 id,布局把**剩余的
                                // 空白全给了它** —— 于是图标与文字之间空出一大截
                                // (用户截图:感叹号和错误文字离得很远)。现在图标锁
                                // 0、文字拿 1:间距恒为 spacing,文字靠左、elide 生效。
                                alignment: start;
                                spacing: 6px;
                                status-ico := Text {
                                    visible: root.footer-status-icon() != "";
                                    text: root.footer-status-icon();
                                    font-family: "Material Icons";
                                    color: root.footer-status-color();
                                    font-size: Theme.fs-md;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                                status-txt := Text {
                                    text: root.footer-status-text();
                                    color: root.footer-status-color();
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    // (#foot-status-wide 2026-09-20) 原写死 max-width:320px
                                    // 已删:它让错误文字在右侧还有一大片空白时就被省略。
                                    // 现在宽度交给布局 —— 左组独占「测试连接 → 取消」
                                    // 之间的全部空间(见下方 spacer 移除),文字能一路
                                    // 顶到取消按钮左侧;真放不下时 elide,悬停出浮层。
                                }
                            }
                        }
                        // (#foot-status-underline-r2 2026-09-20) 下划线**移出
                        // VerticalLayout** 改为绝对定位。原先它在布局流里且带显式
                        // width,会向上传播钉住左组的 max-width(原 spacer 注释记的
                        // 就是这个坑),反过来压住状态区能占的宽度;移出后既不反压,
                        // 也能直接跟随文字组的实际显示宽(截断时不再超出文字)。
                        Rectangle {
                            // (#foot-status-underline-r3 2026-09-20) 宽度 = **图标 + 间隙 +
                            // 文字实际显示宽**,与内容严格等长。
                            // 上一版用的是 status-row.width —— 那是 HorizontalLayout 的
                            // 容器宽(会被拉伸到整个状态区),所以下划线远长于文字
                            // (用户截图)。文字若被 elide,取 min(preferred, width) 才是
                            // 真正画出来的那一段。
                            // 本矩形在布局之外(绝对定位),不反压上面的宽度计算。
                            x: 0px;
                            y: (status-box.height + status-row.height) / 2 + 1px;
                            width: (root.footer-status-icon() == "" ? 0px : status-ico.width + 6px)
                                + min(status-txt.preferred-width, status-txt.width);
                            height: 1px;
                            visible: (root.host-missing || root.serial-missing) && status-ta.has-hover;
                            background: Theme.danger;
                        }
                        // (#foot-status-tip 2026-09-20) 文字被省略号截断时,悬停状态区
                        // 浮出完整错误信息。宽度取状态区宽(上限 360px)以承载长句。
                        // 气泡不带 TouchArea,不接收鼠标 → 指针移上去它照常消失,
                        // 不会与状态区的 has-hover 互相触发形成抖动。
                        if (root.host-missing || root.serial-missing)
                            && status-ta.has-hover
                            && status-txt.preferred-width > status-txt.width : Rectangle {
                            x: 0px;
                            y: -self.height - 8px;
                            width: min(status-box.width, 360px);
                            height: tip-txt.preferred-height + 14px;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            background: Theme.popup-bg;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #000000a0;
                            tip-txt := Text {
                                x: 12px;
                                y: 7px;
                                width: parent.width - 24px;
                                text: root.footer-status-text();
                                color: Theme.text-primary;
                                font-size: Theme.fs-sm;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                // (#foot-spacer-removed 2026-09-20) 原 spacer(纯撑开块)已删。
                // 它当年存在,是因为「状态区里那条错误下划线的显式 width 钉住了左组
                // 的 max-width,左组吸不动剩余空间」。现在下划线已移出布局流(见状态
                // 区注释),左组能正常吸满「测试连接 → 取消」之间的空间;留着 spacer
                // 反而会和左组**平分**,把状态区挤到半宽 —— 用户实测错误文字过早被
                // 省略号截断(#foot-status-wide)。
                // 右组 stretch:0,左组吸满后它自然贴右,与原型 .dlg-foot 一致。
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 10px;
                // (#hifi-v17) 页脚按钮 38px 高 / 9px 圆角,同原型 .btn。
                GhostButton {
                    btn-height: 38px;
                    btn-radius: 9px;
                    dialog-chrome: true;
                    // (#foot-btn 2026-09-20) 内容宽,不再均分拉伸。
                    horizontal-stretch: 0;
                    btn-min-width: 0px;
                    hug-width: true;
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
                PrimaryButton {
                    btn-height: 38px;
                    btn-radius: 9px;
                    // (#foot-btn 2026-09-20) 按高保真 .btn 走内容宽:布局里不再
                    // 均分拉伸(原三键被撑成等宽大按钮,把中间错误信息挤没)。
                    horizontal-stretch: 0;
                    btn-min-width: 0px;
                    hug-width: true;
                    text: is-editing ? @tr("Save") : @tr("Create");
                    disabled: root.is-preview;
                    clicked => { root.try-submit(); }
                }
                }
            }
        }
        }   // (#foot-border) VerticalLayout（弹框内容流）闭合

    }
}
