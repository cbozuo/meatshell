                        if root.draft-auth != "key" : HorizontalLayout {
                            spacing: 10px;
                            sf10 := LabeledInput {
                                focus-changed(f) => { if (f) { root.drop-clock += 1; } }
                                dialog-field: true;
                                input-height: 38px;
                                label: @tr("Username");
                                placeholder: @tr("Prompted on connect if blank");
                                value <=> root.draft-user;
