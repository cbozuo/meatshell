        value <=> root.draft-host;
        horizontal-stretch: 1.5;
        min-width: 0;
        clearable: true;
        error: root.host-missing && root.draft-host == "";
        focus-seq: root.host-focus-seq;
        canceled => { root.cancel(); }
        accepted => { root.try-submit(); }
    }
    if root.draft-kind != "serial" : sf3 := LabeledInput {
        focus-changed(f) => { if (f) { root.drop-clock += 1; } }
        dialog-field: true;
        input-height: 38px;
        label: @tr("Port");
        placeholder: root.default-port-of(root.draft-kind);
        value <=> root.draft-port;
        horizontal-stretch: 0.8;
        min-width: 0;
        clearable: true;
        canceled => { root.cancel(); }
        accepted => { root.try-submit(); }
    }
    if root.draft-kind == "serial" : sf4 := LabeledInput {
        focus-changed(f) => { if (f) { root.drop-clock += 1; } }
        dialog-field: true;
        input-height: 38px;
        label: @tr("Serial port");
        placeholder: "COM3  /  /dev/ttyUSB0";
        value <=> root.draft-serial-port;
        horizontal-stretch: 1.5;
        min-width: 0;
        clearable: true;
        error: root.serial-missing && root.draft-serial-port == "";
        focus-seq: root.serial-focus-seq;
        canceled => { root.cancel(); }
        accepted => { root.try-submit(); }
    }
    if root.draft-kind == "serial" : sf5 := LabeledInput {
        focus-changed(f) => { if (f) { root.drop-clock += 1; } }
        dialog-field: true;
        input-height: 38px;
        label: @tr("Baud rate");
        placeholder: "115200";
        value <=> root.draft-baud;
        horizontal-stretch: 0.8;
        min-width: 0;
        clearable: true;
        canceled => { root.cancel(); }
        accepted => { root.try-submit(); }
    }
}
if root.draft-kind == "serial" : HorizontalLayout {
    spacing: 12px;
    SelectField {
        opening => { dialog-focus.focus(); }
        drop-clock <=> root.drop-clock;
        horizontal-stretch: 1;
        min-width: 0;
        label: @tr("Data bits");
        choices: ["7", "8"];
        value: root.draft-data-bits;
        picked(value) => { root.draft-data-bits = value; }
    }
    SelectField {
        opening => { dialog-focus.focus(); }
        drop-clock <=> root.drop-clock;
        horizontal-stretch: 1;
        min-width: 0;
        label: @tr("Stop bits");
        choices: ["1", "2"];
        value: root.draft-stop-bits;
        picked(value) => { root.draft-stop-bits = value; }
    }
    SelectField {
        opening => { dialog-focus.focus(); }
        drop-clock <=> root.drop-clock;
        horizontal-stretch: 1;
        min-width: 0;
        label: @tr("Parity");
        choices: [@tr("None"), @tr("Odd"), @tr("Even")];
        value: root.parity-text(root.draft-parity);
        picked(value) => { root.draft-parity = root.parity-from-text(value); }
    }
    SelectField {
        opening => { dialog-focus.focus(); }
        drop-clock <=> root.drop-clock;
        horizontal-stretch: 1;
        min-width: 0;
        label: @tr("Flow control");
        choices: [@tr("None"), @tr("Hardware"), @tr("Software")];
        value: root.flow-text(root.draft-flow);
        picked(value) => { root.draft-flow = root.flow-from-text(value); }
    }
}
                    }
                    if !root.is-real : VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            border-radius: 11px;
