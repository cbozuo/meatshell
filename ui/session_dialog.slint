                                            mouse-cursor: pointer;
                                            clicked => { root.pick-key-file(); }
                                        }
                                    }
                                }
                                Text {
                                    text: @tr("Pick the private key itself (not the .pub public key)");
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-xs;
                                }
                            }
                            if root.draft-key-inline-mode : VerticalLayout {
                                spacing: 4px;
